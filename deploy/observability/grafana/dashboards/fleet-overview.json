      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "http_route": "route",
              "http_request_method": "method",
              "Value": "p95 (s)"
            }
          }
        }
      ]
    },
