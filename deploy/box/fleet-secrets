#!/usr/bin/env bash
# fleet-secrets: phase 5 of docs/containerization-plan.md, secrets in SSM
# Parameter Store (af-south-1), one SecureString per key under
# /fleet/prod/server/, encrypted with KMS alias/fleet-secrets.
#
#   sudo fleet-secrets import [--overwrite]   today's live .env -> SSM (needs the
#                                              temporary write permission; see below)
#   sudo fleet-secrets render                 SSM -> /etc/fleet/server.env (root 600)
#   sudo fleet-secrets status                 key names: SSM vs server.env vs live .env
#
# The box's role `fleet-app` may only READ that path, and decrypt only through
# SSM. `import` works while ssm-secrets-cloudshell.sh `open` has granted a
# temporary write permission, which `close` removes again.
#
# Values never reach output, command lines (the process list) or any file
# outside root-only places: they pass through a root-only directory on /run
# (RAM) and end in /etc/fleet/server.env, root 600, as before.
#
# DATABASE_URL is imported with sslmode=verify-full and the RDS root
# certificates the image carries (/app/certs), so the app checks it is talking
# to the real database. The live pm2 server keeps its own .env unchanged.
#
# Install: sudo install -o root -g root -m 755 deploy/box/fleet-secrets /usr/local/sbin/fleet-secrets
set -Eeuo pipefail

export AWS_DEFAULT_REGION=af-south-1
PREFIX=/fleet/prod/server
KMS_KEY=alias/fleet-secrets
LIVE_ENV=/home/ubuntu/prod/fleet-server/.env
OUT=/etc/fleet/server.env
NODE_BIN=/home/ubuntu/.nvm/versions/node/v24.20.0/bin
DOTENV=/home/ubuntu/prod/fleet-server/node_modules/dotenv
DB_CA=/app/certs/rds-af-south-1-bundle.pem

die() { echo "fleet-secrets: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run as root (sudo)"
umask 077
WORK=$(mktemp -d /run/fleet-secrets.XXXXXX)   # tmpfs, root 700
trap 'rm -rf "$WORK"' EXIT

node() { "$NODE_BIN/node" "$@"; }

# A dotenv file -> one file per key in $1 (name = key, content = value).
explode() {   # dir, env file
  node -e '
    const fs = require("fs"), [dotenv, dir, file] = process.argv.slice(1)
    const env = require(dotenv).parse(fs.readFileSync(file))
    for (const [k, v] of Object.entries(env)) {
      if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(k)) { console.error("bad key name: " + k); process.exit(1) }
      fs.writeFileSync(dir + "/" + k, v, { mode: 0o600 })
    }' "$DOTENV" "$1" "$2"
}

# DATABASE_URL as the containers should use it: the certificate checked.
db_verify_full() {   # file holding the URL, rewritten in place
  node -e '
    const fs = require("fs"), [f, ca] = process.argv.slice(1)
    const u = new URL(fs.readFileSync(f, "utf8"))
    u.searchParams.set("uselibpqcompat", "true")
    u.searchParams.set("sslmode", "verify-full")
    u.searchParams.set("sslrootcert", ca)
    fs.writeFileSync(f, u.toString())' "$1" "$DB_CA"
}

fetch() {   # dir <- every parameter under PREFIX, one file per key
  aws ssm get-parameters-by-path --path "$PREFIX" --recursive --with-decryption --output json > "$WORK/all.json"
  node -e '
    const fs = require("fs"), [src, dir, prefix] = process.argv.slice(1)
    const ps = JSON.parse(fs.readFileSync(src)).Parameters
    for (const p of ps) fs.writeFileSync(dir + "/" + p.Name.slice(prefix.length + 1), p.Value, { mode: 0o600 })
    console.log(ps.length)' "$WORK/all.json" "$1" "$PREFIX"
  rm -f "$WORK/all.json"
}

# Hash per key, for comparing sets of values without showing any.
hashes() { ( cd "$1" && for k in *; do [ -f "$k" ] && printf '%s %s\n' "$k" "$(sha256sum < "$k" | cut -c1-64)"; done ) | sort; }

case "${1:-}" in
  import)
    [ -f "$LIVE_ENV" ] || die "missing $LIVE_ENV"
    mkdir "$WORK/env"; explode "$WORK/env" "$LIVE_ENV"
    db_verify_full "$WORK/env/DATABASE_URL"
    over=""; [ "${2:-}" = --overwrite ] && over=--overwrite
    n=0; skipped=0
    for f in "$WORK"/env/*; do
      k=$(basename "$f")
      [ "$(stat -c %s "$f")" -le 4096 ] || die "$k is longer than 4 KB (Standard tier limit)"
      if out=$(aws ssm put-parameter --name "$PREFIX/$k" --type SecureString --key-id "$KMS_KEY" \
                 --value "file://$f" $over --output text 2>&1); then n=$((n + 1))
      elif printf %s "$out" | grep -q ParameterAlreadyExists; then skipped=$((skipped + 1))
      else die "$k: $(printf %s "$out" | tail -1 | cut -c1-160)"; fi
    done
    echo "imported $n keys into $PREFIX (SecureString, $KMS_KEY); $skipped already there (use --overwrite to replace)"
    echo "DATABASE_URL was stored with sslmode=verify-full and sslrootcert=$DB_CA"
    echo "Now remove the write permission: bash ssm-secrets-cloudshell.sh close" ;;

  render)
    mkdir "$WORK/ssm"
    n=$(fetch "$WORK/ssm")
    [ "$n" -gt 0 ] || die "no parameters under $PREFIX"
    # One KEY='value' line per key, which compose's env_file reads literally.
    node -e '
      const fs = require("fs"), [dir] = process.argv.slice(1)
      const lines = []
      for (const k of fs.readdirSync(dir).sort()) {
        const v = fs.readFileSync(dir + "/" + k, "utf8")
        if (/[\n\r]/.test(v) || v.includes("\x27")) { console.error(k + ": contains a newline or a single quote; env_file cannot hold it literally"); process.exit(1) }
        lines.push(k + "=\x27" + v + "\x27")
      }
      fs.writeFileSync(dir + "/../server.env", "# Written by fleet-secrets render from SSM " + process.argv[2] + ". Do not edit: change the parameter and render again.\n" + lines.join("\n") + "\n", { mode: 0o600 })' \
      "$WORK/ssm" "$PREFIX"
    # Read back through dotenv, the way the readiness check reads it, before it replaces anything.
    mkdir "$WORK/back"; explode "$WORK/back" "$WORK/server.env"
    [ "$(hashes "$WORK/ssm")" = "$(hashes "$WORK/back")" ] || die "the rendered file does not read back as SSM holds it; nothing replaced"
    changed=""
    if [ -f "$OUT" ]; then
      mkdir "$WORK/old"; explode "$WORK/old" "$OUT"
      changed=$(diff <(hashes "$WORK/old") <(hashes "$WORK/ssm") | awk '/^[<>]/ {print $2}' | sort -u | paste -sd' ')
      install -o root -g root -m 600 "$OUT" "$OUT.prev"
    fi
    install -o root -g root -m 600 "$WORK/server.env" "$OUT"
    echo "rendered $n keys from SSM into $OUT ($([ -n "$changed" ] && echo "changed: $changed" || echo "no change"))" ;;

  status)
    mkdir "$WORK/ssm" "$WORK/live" "$WORK/file"
    n=$(fetch "$WORK/ssm" 2>/dev/null) || { echo "SSM $PREFIX: not readable by this box yet (run ssm-secrets-cloudshell.sh open, then import)"; exit 0; }
    explode "$WORK/live" "$LIVE_ENV"
    [ -f "$OUT" ] && explode "$WORK/file" "$OUT"
    echo "SSM $PREFIX: $n keys; live .env: $(ls "$WORK/live" | wc -l) keys; $OUT: $(ls "$WORK/file" | wc -l) keys"
    echo "SSM vs live .env, keys that differ: $(diff <(hashes "$WORK/ssm") <(hashes "$WORK/live") | awk '/^[<>]/ {print $2}' | sort -u | paste -sd' ' | sed 's/^$/none/')"
    echo "SSM vs $OUT, keys that differ:  $(diff <(hashes "$WORK/ssm") <(hashes "$WORK/file") | awk '/^[<>]/ {print $2}' | sort -u | paste -sd' ' | sed 's/^$/none/')" ;;

  *) die "usage: fleet-secrets import [--overwrite] | render | status" ;;
esac
