#!/usr/bin/env bash
# fleet-web: phase 3 of docs/containerization-plan.md, new-ui as a container.
#
# The web container (ghala:raitrack-<sha>, unprivileged nginx with the built
# site) runs as service `web` of compose project `fleet` on 127.0.0.1:8081. The host's nginx
# keeps TLS, /api and /webhook; switching only changes where `/` comes from,
# with a reload, so neither direction drops a request.
#
#   sudo fleet-web mode            static | container
#   sudo fleet-web check <sha>     compare the image with the site served today; changes nothing live
#   sudo fleet-web up <sha>        start or replace the container (switches nothing by itself)
#   sudo fleet-web switch          host nginx: / -> the container   (goes back by itself on a failed check)
#   sudo fleet-web back            host nginx: / -> ~/prod/dash/build again
#   sudo fleet-web status
#
# Install (root-owned):
#   sudo install -o root -g root -m 755 deploy/box/fleet-web /usr/local/sbin/fleet-web
#   sudo install -o root -g root -m 644 docker-compose.phase3.yml /etc/fleet/compose/docker-compose.phase3.yml
#
# ~/prod/dash/build stays in place as the way back until phase 4.
set -Eeuo pipefail

REGION=af-south-1
COMPOSE_DIR=/etc/fleet/compose
PROJECT=fleet          # same project as the server: the phase 4 edge reaches web and server on its networks
PORT=8081
CHECK_PORT=8082
STATE=/etc/fleet/web.deployed
STATIC_DIR=/home/ubuntu/prod/dash/build
LOCATIONS=/etc/nginx/fleet/locations.conf
STATIC_COPY=/etc/nginx/fleet/locations.conf.static   # the static version, kept for `back`
MIN_FREE_GIB=3
PULL_WAIT_S=${PULL_WAIT_S:-0}   # CI passes 1200: its image may still be on the way

die() { echo "fleet-web: $*" >&2; exit 1; }
say() { echo "--- $*"; }
[ "$(id -u)" = 0 ] || die "run as root (sudo)"

ACCOUNT=$(aws sts get-caller-identity --query Account --output text)
REGISTRY="${ACCOUNT}.dkr.ecr.${REGION}.amazonaws.com"
REPO="${REGISTRY}/ghala"

# The base file also describes the server; nothing here starts it, and it gets
# no env file to read.
compose() {
  FLEET_SERVER_IMAGE=unused FLEET_ENV_FILE=/dev/null RAITRACK_IMAGE="${IMAGE:-${REPO}:raitrack-none}" WEB_HOST_PORT="$PORT" \
    docker compose -f "$COMPOSE_DIR/docker-compose.prod.yml" -f "$COMPOSE_DIR/docker-compose.phase3.yml" \
      -p "$PROJECT" --profile web "$@"
}

valid_sha() { [[ "${1:-}" =~ ^[0-9a-f]{40}$ ]] || die "expected a 40-character commit sha, got '${1:-}'"; }
current() { [ -f "$STATE" ] && sed -n 1p "$STATE" || true; }
previous() { [ -f "$STATE" ] && sed -n 2p "$STATE" || true; }
mode() { grep -q "proxy_pass http://127.0.0.1:${PORT};" "$LOCATIONS" && echo container || echo static; }

pull() {
  local img=$1 free waited=0
  free=$(df --output=avail -BG / | tail -1 | tr -dc 0-9)
  [ "$free" -ge "$MIN_FREE_GIB" ] || die "only ${free} GiB free on /, need ${MIN_FREE_GIB}"
  docker image inspect "$img" >/dev/null 2>&1 && return 0
  trap 'docker logout "$REGISTRY" >/dev/null 2>&1 || true' EXIT
  aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$REGISTRY" >/dev/null
  until docker pull -q "$img" >/dev/null 2>&1; do
    [ "$waited" -lt "$PULL_WAIT_S" ] || { docker logout "$REGISTRY" >/dev/null; trap - EXIT; die "image not in ECR after ${PULL_WAIT_S}s: ${img##*/}"; }
    [ "$waited" = 0 ] && echo "waiting for CI to push ${img##*/} ..."
    sleep 20; waited=$((waited + 20))
  done
  docker logout "$REGISTRY" >/dev/null; trap - EXIT
  echo "pulled ${img##*/}"
}

# Status, Cache-Control and Content-Type of one path, as one line. Host nginx
# is asked on plain HTTP by address, which is its default_server: the same
# locations.conf as the HTTPS site, without the redirect.
probe() { curl -s -o /dev/null -m 5 -w '%{http_code} cc=[%header{cache-control}] ct=[%header{content-type}]' "$1"; }

served_commit() { curl -fsS -m 5 "$1/DEPLOYED_COMMIT" 2>/dev/null | cut -d' ' -f1; }

# The same answers from two places, for paths that matter to browsers. Each
# side's entry script is its own: the hashed name differs between builds.
compare() {   # base-a base-b
  local a=$1 b=$2 p pa pb bad=0
  for p in / /index.html /some/spa/route @entry /assets/does-not-exist.js /favicon.ico; do
    pa=$p; pb=$p
    if [ "$p" = @entry ]; then pa=$(entry "$a"); pb=$(entry "$b"); fi
    if [ "$(probe "$a$pa")" = "$(probe "$b$pb")" ]; then echo "OK   $pb  $(probe "$b$pb")"
    else echo "FAIL $pb  was: $(probe "$a$pa")  now: $(probe "$b$pb")"; bad=1; fi
  done
  return $bad
}
entry() { curl -fsS -m 5 "$1/index.html" | grep -oE '/assets/index-[A-Za-z0-9_-]+\.js' | head -1; }

# Every build stamps its own time and commit into the bundle (vite.config.js
# defines), and Vite's hashed file names follow from the content. Set those
# aside and two builds of the same source must match file for file.
fingerprint() {   # dir short-commit -> "name sha256" per file, stamps aside
  ( cd "$1" && find . -type f ! -name DEPLOYED_COMMIT | sort | while read -r f; do
      n=$(printf %s "$f" | sed -E 's/-[A-Za-z0-9_-]{8}\.(js|css)$/-<H>.\1/')
      case "$f" in
        *.js|*.css|*.html|*.json|*.map)
          h=$(sed -E -e 's/"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z"/"<BUILT>"/g' \
                     -e 's/-[A-Za-z0-9_-]{8}\.(js|css)/-<H>.\1/g' \
                     -e "s/\"$2\"/\"<COMMIT>\"/g" "$f" | sha256sum | cut -c1-64) ;;
        *) h=$(sha256sum "$f" | cut -c1-64) ;;
      esac
      echo "$n $h"
    done ) | sort
}

wait_healthy() {
  local st i
  for i in $(seq 1 30); do
    st=$(docker inspect -f '{{.State.Health.Status}}' "${PROJECT}-web-1" 2>/dev/null || echo missing)
    [ "$st" = healthy ] && return 0
    sleep 2
  done
  echo "web container is $st"; return 1
}

record() {
  printf '%s\n%s\n' "$1" "${2:-}" > "$STATE"; chmod 644 "$STATE"
  local keep1="${REPO}:raitrack-$1" keep2="${REPO}:raitrack-${2:-none}" img
  for img in $(docker images "$REPO" --format '{{.Repository}}:{{.Tag}}'); do
    case "$img" in "$keep1"|"$keep2") ;; *:raitrack-*) docker rmi "$img" >/dev/null 2>&1 || true ;; esac
  done
  docker image prune -f >/dev/null
}

nginx_reload() { nginx -t 2>&1 | tail -1 && systemctl reload nginx; sleep 1; }

case "${1:-}" in
  mode) mode ;;

  status)
    say "mode: $(mode)   current: $(current)   previous: $(previous)"
    compose ps
    echo "served through nginx: $(served_commit http://127.0.0.1)" ;;

  check)
    sha="${2:-}"; valid_sha "$sha"; img="${REPO}:raitrack-${sha}"
    pull "$img"
    docker rm -f fleet-web-check >/dev/null 2>&1 || true
    docker run -d --name fleet-web-check --read-only --tmpfs /tmp:size=32m --cap-drop ALL \
      --security-opt no-new-privileges -p "127.0.0.1:${CHECK_PORT}:8080" "$img" >/dev/null
    trap 'docker rm -f fleet-web-check >/dev/null 2>&1 || true' EXIT
    for _ in $(seq 1 20); do curl -fsS -m 2 -o /dev/null "http://127.0.0.1:${CHECK_PORT}/" && break; sleep 1; done
    rc=0
    say "files: image vs $STATIC_DIR (build time, commit and hashed names aside)"
    tmp=$(mktemp -d); trap 'docker rm -f fleet-web-check >/dev/null 2>&1 || true; rm -rf "$tmp"' EXIT
    docker cp -q fleet-web-check:/usr/share/nginx/html "$tmp/img"
    live_c=$(served_commit http://127.0.0.1 | cut -c1-7); img_c=$(printf %s "$sha" | cut -c1-7)
    if diff <(fingerprint "$tmp/img" "$img_c") <(fingerprint "$STATIC_DIR" "$live_c") > "$tmp/diff"; then
      echo "OK   all $(find "$STATIC_DIR" -type f | wc -l) files match"
    else
      echo "FAIL $(grep -c '^[<>]' "$tmp/diff") lines differ (< image, > served today):"; head -20 "$tmp/diff"; rc=1
    fi
    say "answers: served today (host nginx) vs the image"
    compare http://127.0.0.1 "http://127.0.0.1:${CHECK_PORT}" || rc=1
    [ "$(docker exec fleet-web-check id -u)" != 0 ] && echo "OK   runs as uid $(docker exec fleet-web-check id -u)" || { echo "FAIL runs as root"; rc=1; }
    echo "served today: $(served_commit http://127.0.0.1)   image: $(served_commit "http://127.0.0.1:${CHECK_PORT}")"
    [ $rc = 0 ] && echo "READY: ${sha}" || die "NOT READY: fix the FAIL lines first" ;;

  up)
    sha="${2:-}"; valid_sha "$sha"; prev=$(current)
    [ "$sha" = "$prev" ] && [ "$(served_commit "http://127.0.0.1:${PORT}")" = "$sha" ] && { echo "already running ${sha}"; exit 0; }
    pull "${REPO}:raitrack-${sha}"
    IMAGE="${REPO}:raitrack-${sha}" compose up -d --no-deps web
    if wait_healthy && [ "$(served_commit "http://127.0.0.1:${PORT}")" = "$sha" ]; then
      record "$sha" "$prev"; echo "WEB UP ${sha} on 127.0.0.1:${PORT} (nginx mode: $(mode))"
    else
      [ -n "$prev" ] || die "${sha} is not healthy and there is no previous image"
      IMAGE="${REPO}:raitrack-${prev}" compose up -d --no-deps web; wait_healthy || true
      die "web ${sha} failed and was rolled back to ${prev}"
    fi ;;

  switch)
    [ "$(mode)" = static ] || die "already switched"
    sha=$(current); [ -n "$sha" ] || die "no web container yet: fleet-web up <sha>"
    [ "$(served_commit "http://127.0.0.1:${PORT}")" = "$sha" ] || die "the web container is not answering with ${sha}"
    grep -q "^root ${STATIC_DIR};" "$LOCATIONS" || die "$LOCATIONS does not look like the static version"
    install -m 644 "$LOCATIONS" "$STATIC_COPY"
    # Everything from the static `root` up to the webhook block becomes one proxy.
    awk -v port="$PORT" '
      /^root \/home\/ubuntu\/prod\/dash\/build;/ { skip = 1
        print "# The site, from the web container (phase 3, fleet-web). Its own nginx"
        print "# sets the cache headers. Back to the files: sudo fleet-web back"
        print "location / {"
        print "    proxy_pass http://127.0.0.1:" port ";"
        print "    proxy_http_version 1.1;"
        print "    proxy_set_header Host $host;"
        print "    proxy_set_header Connection \"\";"
        print "}"
        print ""
        next }
      /^# Controltech EA alert callbacks/ { skip = 0 }
      !skip' "$STATIC_COPY" > "$LOCATIONS.new"
    install -m 644 "$LOCATIONS.new" "$LOCATIONS"; rm -f "$LOCATIONS.new"
    if ! nginx -t >/dev/null 2>&1; then install -m 644 "$STATIC_COPY" "$LOCATIONS"; die "nginx -t failed; static config restored"; fi
    systemctl reload nginx; sleep 1
    ok=1
    [ "$(served_commit http://127.0.0.1)" = "$sha" ] || ok=0
    compare "http://127.0.0.1:${PORT}" http://127.0.0.1 || ok=0
    curl -fsS -m 5 -o /dev/null http://127.0.0.1/api/v1/sim-clock || { echo "FAIL /api through nginx"; ok=0; }
    if [ $ok = 1 ]; then echo "SWITCHED: / is served by the web container ${sha}"
    else install -m 644 "$STATIC_COPY" "$LOCATIONS"; nginx_reload; die "checks failed after the switch; back to static files"; fi ;;

  back)
    [ "$(mode)" = container ] || die "already static"
    [ -f "$STATIC_COPY" ] || die "missing $STATIC_COPY"
    install -m 644 "$STATIC_COPY" "$LOCATIONS"; nginx_reload
    echo "BACK: / is served from ${STATIC_DIR} ($(served_commit http://127.0.0.1)); the container still runs" ;;

  *) die "usage: fleet-web mode | status | check <sha> | up <sha> | switch | back" ;;
esac
