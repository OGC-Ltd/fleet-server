{
  "name": "fleet-server",
  "version": "1.0.0",
  "description": "Fleet Server is the backend platform powering FleetDash, delivering secure APIs, real-time data processing, authentication, and fleet operations services at scale.",
  "homepage": "https://github.com/OGC-Ltd/fleet-server#readme",
  "bugs": {
    "url": "https://github.com/OGC-Ltd/fleet-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OGC-Ltd/fleet-server.git"
  },
  "license": "Apache-2.0",
  "author": "Elisha K. Silas",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env DOTENV_CONFIG_PATH=.env.example tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc",
    "generate": "prisma generate --config prisma.config.ts",
    "migrate": "prisma migrate deploy --config prisma.config.ts",
    "postinstall": "prisma generate --config prisma.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "seed": "tsx prisma/seed.ts",
    "seed:aquamist": "tsx prisma/seed-aquamist.ts",
    "seed:orgs": "tsx prisma/seed-orgs.ts",
    "seed:kasulu": "cross-env DOTENV_CONFIG_PATH=.env.example tsx prisma/seed-kasulu.ts",
    "seed:admins": "cross-env DOTENV_CONFIG_PATH=.env.example tsx prisma/seed-admins.ts",
    "seed:silos": "tsx prisma/seed-silos.ts"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vitest-mock-extended": "^4.0.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  }
}
