{
  "name": "fleet-server",
  "version": "1.0.0",
  "description": "Fleet Server is the backend platform powering FleetDash, delivering secure APIs, real-time data processing, authentication, and fleet operations services at scale.",
  "homepage": "https://github.com/OGC-Ltd/fleet-server#readme",
  "bugs": {
    "url": "https://github.com/OGC-Ltd/fleet-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OGC-Ltd/fleet-server.git"
  },
  "license": "Apache-2.0",
  "author": "Elisha K. Silas",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env DOTENV_CONFIG_PATH=.env tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "prisma generate --config prisma.config.ts && tsc",
    "generate": "prisma generate --config prisma.config.ts",
    "migrate": "prisma migrate deploy --config prisma.config.ts",
    "postinstall": "prisma generate --config prisma.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:db": "vitest run tests/integration/track-sql.db.test.ts",
    "test:db:setup": "psql \"$TEST_DATABASE_URL\" -v ON_ERROR_STOP=1 -c 'CREATE EXTENSION IF NOT EXISTS postgis' -f tests/helpers/track-test-schema.sql -f prisma/migrations/20260808120000_postgis_geofence_geometry/migration.sql",
    "seed": "tsx prisma/seed.ts",
    "seed:aquamist": "tsx prisma/seed-aquamist.ts",
    "seed:orgs": "tsx prisma/seed-orgs.ts",
    "rename:orgs": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/rename-orgs.ts",
    "seed:kasulu": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/seed-kasulu.ts",
    "seed:admins": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/seed-admins.ts",
    "seed:rbac": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/seed-rbac.ts",
    "seed:superadmin": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/seed-superadmin.ts",
    "seed:controltech-user": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/seed-controltech-user.ts",
    "repair:home-orgs": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/repair-home-orgs.ts",
    "sync:vehicles": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-vehicles.ts",
    "sync:machines": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-factorysuite-machines.ts",
    "sync:drivers": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-drivers.ts",
    "seed:org": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/seed-org.ts",
    "sync:wialon": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-wialon.ts --org=KASULU",
    "sync:menengai": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-wialon.ts --org=MENENGAI",
    "sync:westsugar": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-wialon.ts --org=WESTSUGAR",
    "sync:kabras": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-wialon.ts --org=KABRAS",
    "sync:nzoia": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-wialon.ts --org=NZOIA",
    "sync:timsales": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-wialon.ts --org=TIMSALES",
    "sync:aquamist": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-wialon.ts --org=AQUAMIST",
    "sync:geofences": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-geofences.ts",
    "sync:fuel": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-fuel-events.ts",
    "geofence:assign": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/geofence-assign.ts",
    "fix:plates": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/fix-plate-format.ts",
    "link:drivers": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/link-drivers.ts",
    "add:fences": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/add-site-fences.ts",
    "fix:rings": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/fix-ring-geofences.ts",
    "sync:sukari-gps": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-sukari-wialon.ts",
    "sync:alerts": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-alerts.ts",
    "sync:dispatches": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-dispatches.ts",
    "sync:destinations": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/sync-destinations.ts",
    "seed:silos": "tsx prisma/seed-silos.ts",
    "accel:report": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/accel-report.ts",
    "accel:census": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/accel-census.ts",
    "accel:history": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/accel-history.ts",
    "accel:events": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/accel-events.ts",
    "backfill:notifications": "tsx prisma/backfill-notifications.ts",
    "build:trips": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/build-trips.ts",
    "fuel:adjudicate": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/adjudicate-fuel.ts",
    "sim:fuel": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/simulate-fuel-theft.ts",
    "fuel:health": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/fuel-health.ts",
    "backfill:ignition": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/backfill-telemetry-ignition.ts",
    "backfill:driver-vehicles": "cross-env DOTENV_CONFIG_PATH=.env tsx prisma/backfill-driver-vehicles.ts"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vitest-mock-extended": "^4.0.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "rate-limit-redis": "^6.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  }
}
