generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  // Without these, the generator emits extensionless relative imports
  // (e.g. `from './enums'`), which only resolves under a bundler/loader.
  // Plain `node dist/src/index.js` in production needs explicit .js
  // specifiers to resolve ESM imports — same convention already used
  // throughout src/.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum AssignmentType {
  PRIMARY // permanently assigned driver
  RELIEF // temporary / cover assignment
}

enum PeriodType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum FuelEventType {
  FILLING
  THEFT
}

/// What happened to the fuel — a description of the event, never an accusation.
///
/// Wialon's report decides that a level drop is a theft; measured over the 250
/// most recent drains per org, 40% (KASULU) and 50% (SUKARI) of the DECIDABLE
/// volume came back with no filling to explain it — fuel that moved away from
/// the probe and returned, not fuel that left. So the provider's claim is
/// adjudicated against our own level series before it is reported as anything.
///
/// The values changed on 2026-08-11 at the operator's instruction: LOSS and
/// UNVERIFIED are gone. LOSS asserted where the fuel went, which telemetry
/// cannot see; UNVERIFIED described our EVIDENCE rather than the fuel, and
/// covered 1,938 of 2,571 rows, leaving the ledger unreadable. How sure we are
/// now lives in verdictReason and in `isConfirmed` beside the verdict, not
/// instead of it. See modules/fuel/fuel-adjudication.
/// How a fix's engine state was established — see `VehicleTelemetry.ignitionKnown`.
///
/// Recorded per fix rather than per vehicle because a unit can change source
/// mid-window: a tracker whose ignition line is rewired starts reporting SENSOR
/// where it previously only had METER, and a rule replayed over that window must
/// be able to see the change rather than average across it.
enum IgnitionSource {
  /// A genuine digital ignition line — the only source that needs no inference.
  /// `readIgnition` accepts it only when the value is actually binary.
  SENSOR
  /// The cumulative engine-hours counter advanced between this fix and the last,
  /// so the engine ran in between. A measurement, not a heuristic.
  METER
  /// External supply voltage, thresholded per unit against its own two modes
  /// (alternator charging vs at rest). The weakest of the three; adopted only
  /// where a unit's distribution is genuinely bimodal.
  VOLTAGE
  /// Nothing could establish it. `engineOn` on such a row is the speed fallback
  /// and says only whether the vehicle moved.
  NONE
}

/// The denominator a machine's fuel use is measured against.
///
/// Mirrors `ConsumptionBasis` in modules/fuel/fuel-theft-classifier, which is
/// where `resolveBasis` decides it; this enum only records the decision so a
/// stored rate says which of its two figures is the real one. The rule, from
/// the operator: machines whose work IS travelling are judged per kilometre,
/// machines that burn while stationary are judged per engine-hour.
enum ConsumptionBasis {
  /// Litres per engine-hour. Excavators, dozers, loaders, graders, generators,
  /// and tractors — a tractor works the field at 0 km/h and would score its
  /// whole burn as unexplained on a distance denominator.
  HOURS
  /// Litres per kilometre, held internally as km/L. Trucks, lorries, trailers,
  /// buses, saloons and company vehicles. Note this is the basis of the MACHINE;
  /// `applicableBasis` still sends a road vehicle that did not travel back to
  /// HOURS for the fall being judged, because an idling truck is burning, not
  /// driving.
  DISTANCE
}

enum FuelEventVerdict {
  PENDING // too recent to judge — the level may still come back
  REFILL // a filling explains it: fuel went IN, it did not leave
  DRAIN // the level went down and did not come back
  REDISTRIBUTION // the level returned with no filling: undulation, it never left
  /// The fuel probe failed, not the tank. Not a fuel event at all, and never
  /// announced: blaming a driver for a dead sensor is the one outcome here
  /// that is worse than missing a real drain.
  SENSOR_FAULT
}

/// WHY the fuel left, once `FuelEventVerdict` has established that it did.
///
/// A SECOND question and therefore a second field. `verdict` answers "did the
/// fuel leave the tank" and is written on 3,300 historical rows read by the
/// analytics, the reports, the AI insight and the dashboard; folding cause into
/// it would silently change what every one of those means.
///
/// Only UNEXPLAINED_BURN and SIPHON reach an operator, and only SIPHON may be
/// worded as possible theft — see `modules/fuel/fuel-theft-classifier`.
enum FuelDrainCause {
  /// Consistent with what this machine burns. Not an incident.
  ENGINE_BURN
  /// Above the expected band but below the alerting multiple. Silent.
  HIGH_BURN
  /// Far above anything the machine's own consumption explains. Announced,
  /// but NEVER as theft: a leak, a mis-calibrated probe and a wrong expected
  /// rate all produce this, and so does theft.
  UNEXPLAINED_BURN
  /// Engine provably off, sustained, not settling and not a probe step. The
  /// only cause that may be described as possible theft.
  SIPHON
  /// A rate no engine could burn and no pump could draw — the reading, not
  /// the tank.
  SLOSH
  /// Parked, and the fall decays like liquid finding its level.
  SETTLING
  /// Not enough evidence to say. The default, and the most common by far:
  /// half the ledger has no measured ignition, which is an accepted blind
  /// spot rather than a gap to be guessed across.
  INDETERMINATE
}

/// Shape of a geofence boundary.
enum GeofenceType {
  CIRCLE // defined by centerLat + centerLng + radiusM
  POLYGON // defined by polygonCoords (GeoJSON ring)
  LINE // corridor: polygonCoords is the centre-line, widthM its width
}

/// Controls whether the fence is an allowed zone or a forbidden zone.
enum FenceMode {
  ALLOWLIST // vehicle must stay INSIDE — alert on exit
  BLOCKLIST // vehicle must stay OUTSIDE — alert on entry
}

/// Structured cargo classification — prevents free-text inconsistency.
/// Which lifecycle produced a `dispatches` row.
///
/// CANE  — the original RaiFactorySuite `/dispatches` resource. A unit signs
///         out to a cane zone and comes back; the dispatcher raises the
///         paperwork and the provider tracks DISPATCHED → COMPLETED.
///
/// SALES — the `/sales` resource (Naitiri, live 2026-09-09). Finished sugar
///         leaving for a customer. The SALES OFFICE creates the run with a
///         tonnage and a destination, then the GATE GUARD signs the unit out
///         and signs it back in — so the row mutates through three states and
///         carries a weight, which a cane dispatch never does.
///
/// One table because the map tooltip, the trip linking in lib/dispatch-trip and
/// the per-destination duration statistics all key off `dispatches`, and a
/// sales run wants every one of them. The discriminator is what lets a query
/// that must see only one population say so.
enum DispatchKind {
  CANE
  SALES
}

enum CargoType {
  BULK
  PACKAGED
  LIVESTOCK
  HAZMAT
  FUEL
  MACHINERY
  OTHER
}

/// Severity tier for live operational alerts in the Fleet Operations feed.
enum AlertSeverity {
  WARNING
  CRITICAL
}

// ---------------------------------------------------------------------------
// IAM — identity & access control
// ---------------------------------------------------------------------------

/// Top-level tenant. All entities are scoped to an organisation.
model Organisation {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  /// The yard/plant every dispatch leaves from and returns to, MEASURED from
  /// the fleet's own telemetry (the densest cell of fixes) rather than typed
  /// in — see prisma/sync-destinations.ts. NULL until that script has run.
  ///
  /// It is the origin of every round trip: the provider records a destination
  /// and nothing else, so "where did it set off from" has no other source.
  hubLat      Float?   @map("hub_lat")
  hubLng      Float?   @map("hub_lng")
  /// The GATE the fleet actually leaves through — the barrier/weigh-out, not
  /// the yard's centre. Distinct from the hub even when they are metres apart
  /// (SUKARI's are 17 m apart), because a departure is measured against the
  /// gate and "at the yard" is measured against the hub. Supplied by the
  /// operator, and re-derivable from telemetry: the gate is where outbound
  /// vehicles halt, which clusters far more tightly than anything else on the
  /// way out. NULL falls back to the hub radius — see lib/yard-departure.
  gateLat     Float?   @map("gate_lat")
  gateLng     Float?   @map("gate_lng")
  /// How far past the gate counts as through it. Sized from the measured halt
  /// spread (13-20 m at SUKARI), wide enough to contain the halt and narrow
  /// enough to stay clear of the next cluster inside the site.
  gateRadiusM Int?     @map("gate_radius_m")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles                Role[]
  memberships          OrgMembership[]
  users                User[]
  vehicleGroups        VehicleGroup[]
  vehicles             Vehicle[]
  reportingPeriods     ReportingPeriod[]
  routes               Route[]
  geofences            Geofence[]
  ingestApiKeys        IngestApiKey[]
  pushSubscriptions    PushSubscription[]
  alerts               VehicleAlert[]
  speedingIncidents    SpeedingIncident[]
  sensorFaultEpisodes  SensorFaultEpisode[]
  silos                Silo[]
  providerAlerts       ProviderAlert[]
  notifications        Notification[]
  dispatches           Dispatch[]
  dispatchDestinations DispatchDestination[]

  @@map("organisations")
}

/// Named role scoped to an organisation (e.g. "fleet_manager", "driver", "mechanic").
model Role {
  id             String   @id @default(cuid())
  /// NULL = a PLATFORM role: its permissions apply in every organisation.
  /// Used by super_admin and director, and by nothing else — an org-scoped
  /// role cannot express "all tenants" because it is keyed to one.
  organisationId String?  @map("organisation_id")
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation?    @relation(fields: [organisationId], references: [id])
  permissions  RolePermission[]
  userRoles    UserRole[]

  // Platform roles are NOT covered by this: Postgres treats NULLs as
  // distinct, so two roles with organisation_id NULL and the same slug both
  // satisfy it. A partial unique index in the migration closes that.
  @@unique([organisationId, slug])
  @@index([organisationId])
  @@map("roles")
}

/// Atomic capability — resource + action (e.g. vehicle:read, trip:create).
model Permission {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  resource String // e.g. "vehicle", "trip", "fuel_theft"
  action   String // e.g. "read", "create", "update", "delete"

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

/// Many-to-many join: which permissions belong to which role.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// A person who can log in to the system and/or be assigned to a vehicle.
/// Drivers are Users who hold the "driver" Role.
model User {
  id                  String     @id @default(cuid())
  organisationId      String     @map("organisation_id")
  fullName            String     @map("full_name")
  // NULL for people synced from the RaiFactorySuite driver registry — the
  // provider holds no email addresses and drivers don't log in. Postgres
  // permits many NULLs under a unique index, so logins stay unaffected.
  email               String?    @unique
  phone               String?
  licenceNumber       String?    @map("licence_number")
  employeeId          String?    @map("employee_id")
  // RaiFactorySuite driver UUID — the stable upsert key for sync:drivers.
  externalId          String?    @unique @map("external_id")
  // Provider's DUTY state (ON_DUTY / OFF_DUTY / TERMINATED) — distinct from
  // `status`, which is employment standing in our own RBAC model.
  dutyStatus          String?    @map("duty_status")
  // Provider's driver class (TRACTOR / TRUCK / COMPANY_VEHICLE) — the vehicle
  // type this driver is licensed to operate.
  driverType          String?    @map("driver_type")
  status              UserStatus @default(ACTIVE)
  // bcrypt hash for local auth (scripts/set-password.ts sets it).
  // NULL = account cannot log in (all pre-2026-07 accounts start this way —
  // auth previously lived in Supabase and its user pool was never populated).
  passwordHash        String?    @map("password_hash")
  /// When the password was last set, and how many times it has been set.
  /// There was no record of this at all: an operator asking "when did this
  /// account last change its password" had nowhere to look, and neither did
  /// the person who owned it. Two columns rather than an audit table — the
  /// question asked was when and how many, not from which IP.
  passwordChangedAt   DateTime?  @map("password_changed_at")
  passwordChangeCount Int        @default(0) @map("password_change_count")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at") // soft delete — preserves FK integrity on trips

  // Persisted driver rating (1.0–5.0, starts at 5.0). Overspeeding is scored
  // per-trip and updated here on trip completion (see simulation.persistence.ts)
  // so the score can self-heal on clean trips instead of being recomputed from
  // a rolling window every time. Only meaningful when the user holds the
  // "driver" role.
  driverRatingScore Float @default(5.0) @map("driver_rating_score")

  organisation Organisation @relation(fields: [organisationId], references: [id])

  // IAM
  userRoles             UserRole[]
  memberships           OrgMembership[] @relation("MembershipUser")
  membershipsGranted    OrgMembership[] @relation("MembershipGrantedBy")
  authSessions          AuthSession[]
  passwordTokens        PasswordToken[] @relation("PasswordTokenUser")
  passwordTokensCreated PasswordToken[] @relation("PasswordTokenCreatedBy")

  // Driver-specific relations (only relevant when user holds "driver" role)
  vehicleAssignments VehicleAssignment[] @relation("AssignedUser")
  trips              Trip[]              @relation("TripDriver")
  fuelThefts         FuelTheft[]         @relation("TheftDriver")
  geofenceViolations GeofenceViolation[] @relation("ViolationDriver")
  speedingIncidents  SpeedingIncident[]  @relation("SpeedingDriver")

  // Audit — who assigned/unassigned
  assignmentsGranted   VehicleAssignment[] @relation("AssignedByUser")
  userRolesGranted     UserRole[]          @relation("UserRoleGrantedBy")
  geofencesAssigned    VehicleGeofence[]   @relation("GeofenceAssignedBy")
  ingestApiKeysCreated IngestApiKey[]      @relation("ApiKeyCreatedBy")

  // Notifications
  pushSubscriptions PushSubscription[]

  @@index([organisationId])
  @@index([email])
  @@index([organisationId, status])
  @@map("users")
}

/// Audit-tracked role grant. Soft-revoked via revokedAt rather than hard-deleted.
model UserRole {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  roleId       String    @map("role_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  revokedAt    DateTime? @map("revoked_at")
  assignedById String?   @map("assigned_by")

  user       User  @relation(fields: [userId], references: [id])
  role       Role  @relation(fields: [roleId], references: [id])
  assignedBy User? @relation("UserRoleGrantedBy", fields: [assignedById], references: [id])

  @@index([userId])
  @@index([roleId])
  @@index([userId, revokedAt]) // fast "active roles for user" query
  // No @@unique([userId, roleId]) — grants are SOFT-revoked, so a plain
  // unique would make a revoked role ungrantable ever again. The migration
  // adds a PARTIAL unique index (WHERE revoked_at IS NULL) instead, which
  // forbids two LIVE grants of one role while leaving history alone. That
  // is the constraint user.service.ts:34 already catches P2002 for.
  @@map("user_roles")
}

/// Which organisations a person may reach, and how much of each fleet.
///
/// This is the authority for cross-tenant access. `User.organisationId` is who
/// EMPLOYS someone and stays exactly as it was — 551 driver rows depend on it,
/// and it backs the roster query in analytics.repository. Membership is a
/// different question: which tenants may this account read. One person can hold
/// several, with a different role in each (roles are org-scoped, so the role
/// grant itself carries the organisation).
///
/// The vehicle scope lives here rather than on the role because two operators
/// holding the same role routinely watch different trucks.
model OrgMembership {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  organisationId String    @map("organisation_id")
  /// true  — every vehicle in the organisation, including ones added later.
  /// false — only what `vehicleScopes` names. Defaulting to TRUE keeps the
  ///         meaning of every backfilled row unchanged; narrowing is opt-in.
  allVehicles    Boolean   @default(true) @map("all_vehicles")
  createdAt      DateTime  @default(now()) @map("created_at")
  /// Soft revoke, matching UserRole — an access history is worth keeping.
  revokedAt      DateTime? @map("revoked_at")
  createdById    String?   @map("created_by")

  user          User                     @relation("MembershipUser", fields: [userId], references: [id])
  organisation  Organisation             @relation(fields: [organisationId], references: [id])
  createdBy     User?                    @relation("MembershipGrantedBy", fields: [createdById], references: [id])
  vehicleScopes MembershipVehicleScope[]

  @@unique([userId, organisationId])
  @@index([userId, revokedAt])
  @@index([organisationId])
  @@map("org_memberships")
}

/// One entry in a restricted membership's visible-vehicle set.
///
/// Exactly one of `vehicleId` / `vehicleGroupId` is set — enforced by a CHECK
/// constraint in the migration, because Prisma cannot express it. A group entry
/// is not sugar for listing its members: vehicles added to that group later are
/// included automatically, which is the whole reason to scope by group on a
/// 486-unit fleet.
///
/// Deliberately NOT VehicleAssignment. That table means "who DRIVES this
/// vehicle" — ingest.service reads it to stamp driver_id onto telemetry, and
/// vehicle.service enforces one active PRIMARY per vehicle. Giving an operator
/// forty vehicles to watch through it would record them as the driver of all
/// forty and corrupt every driver metric downstream.
model MembershipVehicleScope {
  id             String  @id @default(cuid())
  membershipId   String  @map("membership_id")
  vehicleId      String? @map("vehicle_id")
  vehicleGroupId String? @map("vehicle_group_id")

  membership   OrgMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])
  vehicleGroup VehicleGroup? @relation(fields: [vehicleGroupId], references: [id])

  @@unique([membershipId, vehicleId])
  @@unique([membershipId, vehicleGroupId])
  @@index([membershipId])
  @@map("membership_vehicle_scopes")
}

/// A live refresh-token family. Access tokens stay stateless JWTs; refresh
/// tokens are stored so they can be ROTATED and so a leak can be detected.
///
/// `tokenHash` is sha256 of an opaque 32-byte token — not a JWT, because once a
/// token is stored server-side a signature proves nothing the lookup does not.
///
/// Rotation: each refresh stamps `rotatedAt` on the row it consumed and issues a
/// successor sharing `familyId`. Presenting an already-rotated token therefore
/// means two parties hold it, so the whole family is revoked rather than the one
/// row — the legitimate holder is forced to log in again, which is the point.
model AuthSession {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  familyId      String    @map("family_id")
  tokenHash     String    @unique @map("token_hash")
  issuedAt      DateTime  @default(now()) @map("issued_at")
  expiresAt     DateTime  @map("expires_at")
  rotatedAt     DateTime? @map("rotated_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  userAgent     String?   @map("user_agent")
  ip            String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt]) // the expiry sweep
  @@map("auth_sessions")
}

/// Purpose of a password-setting link. One table serves both because the
/// lifecycle is identical — single-use, hashed at rest, expiring, revocable,
/// consumed in the same transaction that writes the new password hash. They
/// differ only in how long they last and what the email says, and two tables
/// would mean two consumption paths where consumption is the half that must be
/// exactly right.
enum PasswordTokenPurpose {
  INVITE
  RESET
}

/// An emailed link that lets someone set a password.
///
/// Shaped after AuthSession deliberately: the raw token goes to the person and
/// only its sha256 is stored, so a database read cannot recover a working
/// link. Single-use is enforced by the QUERY (consumedAt/revokedAt null and
/// expiresAt in the future) plus writing consumedAt inside the same
/// transaction as the password update — not by a boolean somebody has to
/// remember to check.
model PasswordToken {
  id            String               @id @default(cuid())
  userId        String               @map("user_id")
  purpose       PasswordTokenPurpose
  tokenHash     String               @unique @map("token_hash")
  createdAt     DateTime             @default(now()) @map("created_at")
  expiresAt     DateTime             @map("expires_at")
  consumedAt    DateTime?            @map("consumed_at")
  revokedAt     DateTime?            @map("revoked_at")
  revokedReason String?              @map("revoked_reason")
  /// The inviting admin. NULL for a self-service reset, which nobody granted.
  createdById   String?              @map("created_by")
  requestedIp   String?              @map("requested_ip")
  requestedUa   String?              @map("requested_user_agent")

  user      User  @relation("PasswordTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PasswordTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt]) // the expiry sweep, when one is written
  @@map("password_tokens")
}

// ---------------------------------------------------------------------------
// DEVICE AUTH — ingest API keys (separate from user JWT auth)
// ---------------------------------------------------------------------------

/// Scoped API key that authorises a GPS/FLS device (or vendor platform) to
/// push telemetry to POST /api/v1/ingest/telemetry.
/// Store only the SHA-256 hash — never the raw key.
model IngestApiKey {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  label          String // human name e.g. "RaiFactorySuite Webhook"
  keyHash        String    @unique @map("key_hash") // SHA-256(rawKey) — raw key shown once at creation
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime? @map("expires_at") // NULL = no expiry
  lastUsedAt     DateTime? @map("last_used_at") // updated on every successful ingest
  createdById    String?   @map("created_by")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  createdBy    User?        @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  @@index([organisationId])
  @@index([keyHash]) // primary lookup on every ingest request
  @@map("ingest_api_keys")
}

// ---------------------------------------------------------------------------
// FLEET — master data
// ---------------------------------------------------------------------------

/// Logical grouping of vehicles (e.g. Harvesting, Ambulance, Sales).
model VehicleGroup {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  name           String
  code           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation     Organisation             @relation(fields: [organisationId], references: [id])
  vehicles         Vehicle[]
  membershipScopes MembershipVehicleScope[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("vehicle_groups")
}

/// A physical vehicle tracked by a GPS/FLS device.
model Vehicle {
  id                 String   @id @default(cuid())
  organisationId     String   @map("organisation_id")
  vehicleGroupId     String   @map("vehicle_group_id")
  name               String
  registrationPlate  String   @unique @map("registration_plate")
  // Telemetry ingest key. There is no on-prem GPS hardware — vehicles are
  // provisioned by the RaiFactorySuite API and polled per-vehicle, so this
  // holds the provider's vehicle UUID (same value as externalId).
  deviceId           String   @unique @map("device_id")
  // RaiFactorySuite vehicle UUID — the stable upsert key for sync:vehicles.
  externalId         String?  @unique @map("external_id")
  vehicleType        String   @map("vehicle_type") // TRACTOR, TRUCK, COMPANY_VEHICLE, …
  /// Manufacturer model, e.g. "CAT D8T", "KOMATSU D155A", "JOHN DEERE 6110B".
  ///
  /// Free text, and nullable because almost nothing has it yet. It exists
  /// because fuel consumption is a property of the MODEL and not of
  /// `vehicleType`: a Cat D6 burns 14-22 L/h and a D11 59-97, and both are
  /// "PLANT". Measured 2026-08-16, `vehicleType` alone was the single largest
  /// source of false fuel alerts — KASULU's TRACTOR label spans 84 L to 1,631 L
  /// tanks and 1.6 to 28.3 L/h, and two machines held to its median produced
  /// 64% of every alert the classifier raised in thirty days.
  ///
  /// Recorded nowhere else. `name` is a copy of the plate on this fleet, and
  /// the Wialon units carry only probe identifiers and SIM ICCIDs in their
  /// custom fields — both checked, neither has it.
  ///
  /// Read by `modules/fuel/fuel-theft-classifier` to pick a burn band. A
  /// vehicle without one falls back to its derived rate, and a vehicle with
  /// neither cannot be judged on consumption at all.
  model              String?  @map("model")
  // Registry status as reported by the provider (AVAILABLE / DISPATCHED /
  // DECOMMISSIONED). Operational status (moving, idling, …) comes from
  // telemetry, not this column.
  status             String?
  // False when the provider decommissions or drops the vehicle — kept as a row
  // for history (trips/alerts FK it) but excluded from the live fleet.
  isActive           Boolean  @default(true) @map("is_active")
  fuelEfficiencyKmpl Float?   @map("fuel_efficiency_kmpl")
  tankCapacityLitres Float?   @map("tank_capacity_litres")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  vehicleGroup VehicleGroup @relation(fields: [vehicleGroupId], references: [id])

  assignments        VehicleAssignment[]
  membershipScopes   MembershipVehicleScope[]
  trips              Trip[]
  engineHourSessions EngineHourSession[]
  fuelFillings       FuelFilling[]
  fuelThefts         FuelTheft[]
  fuelDailyTrends    FuelDailyTrend[]
  dailyStats         VehicleDailyStat[]
  fuelRate           VehicleFuelRate?
  periodSummaries    VehiclePeriodSummary[]
  serviceRecords     VehicleServiceRecord[]
  garageVisits       VehicleGarageVisit[]

  // Live telemetry relations
  sensors            VehicleSensor[]
  telemetry          VehicleTelemetry[]
  geofences          VehicleGeofence[]
  geofenceViolations GeofenceViolation[]
  alerts             VehicleAlert[]
  speedingIncidents  SpeedingIncident[]
  sensorFaults       SensorFaultEpisode[]
  incidentDailyStats VehicleIncidentDailyStat[]
  providerAlerts     ProviderAlert[]
  notifications      Notification[]
  dispatches         Dispatch[]

  @@index([organisationId])
  @@index([vehicleGroupId])
  @@index([deviceId]) // critical — raw telemetry arrives keyed to deviceId
  @@map("vehicles")
}

/// Time-bounded record of which user (driver) is assigned to which vehicle.
/// Query current assignment: WHERE unassignedAt IS NULL AND vehicleId = ?
/// Query assignment on a date: WHERE assignedAt <= date AND (unassignedAt IS NULL OR unassignedAt > date)
model VehicleAssignment {
  id             String         @id @default(cuid())
  vehicleId      String         @map("vehicle_id")
  userId         String         @map("user_id")
  assignmentType AssignmentType @default(PRIMARY) @map("assignment_type")
  assignedAt     DateTime       @default(now()) @map("assigned_at")
  unassignedAt   DateTime?      @map("unassigned_at") // NULL = currently active
  assignedById   String?        @map("assigned_by")
  notes          String?

  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  user       User    @relation("AssignedUser", fields: [userId], references: [id])
  assignedBy User?   @relation("AssignedByUser", fields: [assignedById], references: [id])

  @@index([vehicleId, unassignedAt]) // "who is assigned to this vehicle right now?"
  @@index([userId, unassignedAt]) // "which vehicle is this driver assigned to?"
  @@index([vehicleId, assignedAt]) // time-range lookups for incident investigation
  @@map("vehicle_assignments")
}

// ---------------------------------------------------------------------------
// REPORTING
// ---------------------------------------------------------------------------

/// Named time window that groups all events (e.g. "Week 24", "June 2026").
model ReportingPeriod {
  id             String     @id @default(cuid())
  organisationId String     @map("organisation_id")
  label          String
  periodStart    DateTime   @map("period_start")
  periodEnd      DateTime   @map("period_end")
  periodType     PeriodType @map("period_type")

  organisation Organisation @relation(fields: [organisationId], references: [id])

  trips           Trip[]
  engineSessions  EngineHourSession[]
  fuelFillings    FuelFilling[]
  fuelThefts      FuelTheft[]
  periodSummaries VehiclePeriodSummary[]

  @@index([organisationId, periodStart])
  @@map("reporting_periods")
}

// ---------------------------------------------------------------------------
// ROUTES — named origin-destination paths with ordered waypoints
// ---------------------------------------------------------------------------

/// A pre-defined route between two named locations, optionally with intermediate waypoints.
/// Trips are linked to a route at dispatch time; ad-hoc trips leave routeId NULL.
model Route {
  id              String   @id @default(cuid())
  organisationId  String   @map("organisation_id")
  name            String // "Garissa Depot → Nairobi CBD Warehouse"
  originName      String   @map("origin_name")
  originLat       Float    @map("origin_lat")
  originLng       Float    @map("origin_lng")
  destinationName String   @map("destination_name")
  destinationLat  Float    @map("destination_lat")
  destinationLng  Float    @map("destination_lng")
  distanceKm      Float?   @map("distance_km") // expected / approved distance
  isActive        Boolean  @default(true) @map("is_active") // retire without deleting
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organisation Organisation    @relation(fields: [organisationId], references: [id])
  waypoints    RouteWaypoint[]
  trips        Trip[]

  @@index([organisationId])
  @@index([organisationId, isActive]) // list active routes for an org
  @@map("routes")
}

/// Ordered checkpoint along a Route. Arrival is confirmed when a telemetry ping
/// falls within radiusM of the waypoint's coordinates.
model RouteWaypoint {
  id       String  @id @default(cuid())
  routeId  String  @map("route_id")
  sequence Int // 1-based ordering along the route
  name     String? // e.g. "Thika Bypass Interchange"
  lat      Float
  lng      Float
  radiusM  Int     @default(200) @map("radius_m") // arrival tolerance in metres

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence]) // enforce ordering uniqueness
  @@index([routeId, sequence])
  @@map("route_waypoints")
}

// ---------------------------------------------------------------------------
// GEOFENCING — spatial boundaries with violation tracking
// ---------------------------------------------------------------------------

/// A named spatial boundary applied to one or more vehicles.
model Geofence {
  id             String                                    @id @default(cuid())
  organisationId String                                    @map("organisation_id")
  name           String // "Nairobi CBD Delivery Zone"
  type           GeofenceType // CIRCLE | POLYGON | LINE
  mode           FenceMode                                 @default(ALLOWLIST) @map("mode") // ALLOWLIST | BLOCKLIST
  /// Provider's own zone id (e.g. "wialon:zone:14") — upsert key for syncs.
  externalId     String?                                   @unique @map("external_id")
  // Circle geometry
  centerLat      Float?                                    @map("center_lat")
  centerLng      Float?                                    @map("center_lng")
  radiusM        Int?                                      @map("radius_m")
  // Polygon geometry — GeoJSON LinearRing [[lng,lat],...] stored as Json.
  // Also holds a LINE fence's centre-line path, same [[lng,lat],…] ordering.
  polygonCoords  Json?                                     @map("polygon_coords")
  /// LINE (corridor) only: full width in metres. A vehicle is inside when it
  /// is within widthM/2 of the centre-line — how Wialon models haulage roads,
  /// drains and rivers.
  widthM         Float?                                    @map("width_m")
  /// DERIVED PostGIS shape — a CIRCLE's centre buffered by radiusM, a POLYGON's
  /// ring, a LINE's centre-line buffered by widthM/2. The columns above stay the
  /// source of truth; the `geofences_geom_sync` trigger keeps this in step with
  /// them, so nothing in the app ever writes it. Exists for set-based work the
  /// Json columns cannot do — validating rings, exact areas, and matching
  /// telemetry history against a boundary. Live containment is still evaluated
  /// in memory by lib/zone-presence.ts and does not read this.
  ///
  /// Prisma has no geography type: `Unsupported` means it is never returned by
  /// findMany/findFirst. Read it through $queryRaw.
  geom           Unsupported("geography(Geometry, 4326)")?
  isActive       Boolean                                   @default(true) @map("is_active")
  createdAt      DateTime                                  @default(now()) @map("created_at")
  updatedAt      DateTime                                  @updatedAt @map("updated_at")

  organisation Organisation        @relation(fields: [organisationId], references: [id])
  vehicles     VehicleGeofence[]
  violations   GeofenceViolation[]

  @@index([organisationId])
  @@index([organisationId, isActive])
  @@map("geofences")
}

/// Join table scoping a Geofence to a specific Vehicle, with audit trail.
model VehicleGeofence {
  vehicleId    String   @map("vehicle_id")
  geofenceId   String   @map("geofence_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById String?  @map("assigned_by")

  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  geofence   Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("GeofenceAssignedBy", fields: [assignedById], references: [id])

  @@id([vehicleId, geofenceId])
  @@index([geofenceId])
  @@map("vehicle_geofences")
}

/// Recorded instance of a vehicle crossing a geofence boundary unexpectedly.
/// Written asynchronously by the geofence-evaluation BullMQ worker — never on the ingest hot path.
model GeofenceViolation {
  id         String    @id @default(cuid())
  vehicleId  String    @map("vehicle_id")
  geofenceId String    @map("geofence_id")
  driverId   String?   @map("driver_id")
  occurredAt DateTime  @map("occurred_at") // timestamp from the triggering telemetry ping
  resolvedAt DateTime? @map("resolved_at") // when the vehicle returned / dispatcher acknowledged
  lat        Float
  lng        Float
  speedKmh   Float?    @map("speed_kmh")
  notifiedAt DateTime? @map("notified_at") // when SSE / SMS alert was dispatched

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  geofence Geofence @relation(fields: [geofenceId], references: [id])
  driver   User?    @relation("ViolationDriver", fields: [driverId], references: [id])

  @@index([vehicleId, occurredAt])
  @@index([geofenceId, occurredAt])
  @@index([driverId, occurredAt]) // driver-centric violation reports
  @@index([occurredAt]) // org-wide violation timeline
  @@map("geofence_violations")
}

/// Live operational alert raised from a telemetry flag (overspeeding, fuel
/// theft, low fuel, etc). Stays open (resolvedAt = null) for as long as the
/// underlying condition is still active on each poll cycle — the poller
/// closes it the moment the flag clears. This is what makes a vehicle's
/// critical state survive a page reload instead of disappearing with the
/// transient SSE event that originally raised it.
model VehicleAlert {
  id             String        @id @default(cuid())
  organisationId String        @map("organisation_id")
  vehicleId      String        @map("vehicle_id")
  type           String // AlertType: overspeeding, fuelInconsistency, lowFuel, …
  severity       AlertSeverity
  message        String
  lat            Float?
  lng            Float?
  speedKmh       Float?        @map("speed_kmh")
  fuelLevelMl    Int?          @map("fuel_level_ml")
  meta           Json?
  triggeredAt    DateTime      @map("triggered_at")
  resolvedAt     DateTime?     @map("resolved_at") // null = still active/critical

  organisation Organisation @relation(fields: [organisationId], references: [id])
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])

  @@index([organisationId, resolvedAt])
  @@index([vehicleId, type, resolvedAt])
  /// Date-RANGED reads: findMaintenanceHistory (telemetry.repository) and the
  /// driver-conduct query both filter this exact pair and had no index for it.
  @@index([organisationId, triggeredAt])
  @@map("vehicle_alerts")
}

// ---------------------------------------------------------------------------
// INCIDENT LEDGERS — what happened, as opposed to what is happening
// ---------------------------------------------------------------------------
//
// Three stores overlap with `vehicle_alerts` above and the difference is the
// thing to understand before touching any of them:
//
//   vehicle_alerts             "is this unit in trouble RIGHT NOW" — opened and
//                              closed every poll cycle by syncFrameAlerts,
//                              drives markers, the live feed and SSE.
//   speeding_incidents         "what happened, once, in full" — written ONCE
//                              when an episode ends, never updated.
//   sensor_fault_episodes      "when did it break and when did it come back".
//   vehicle_incident_daily_stats  month-over-month, after the detail is gone.
//
// The enrichment lives here rather than on vehicle_alerts because
// syncFrameAlerts closes every alert type in ONE updateMany: per-type columns
// would carve an exception into the single place alert state is reconciled. And
// an alert that never resolves would never be enriched at all, while a ledger
// needs a closed interval by construction.

/// One completed overspeeding episode.
///
/// Written on the FALLING edge by lib/speeding-episodes, via a worker, so the
/// 2-second poll loop never waits on a write.
model SpeedingIncident {
  id             String  @id @default(cuid())
  organisationId String  @map("organisation_id")
  vehicleId      String  @map("vehicle_id")
  vehicleType    String? @map("vehicle_type")

  /// From the ACTIVE assignment at capture time (poller's DeviceMeta), not
  /// reconstructed by joining Trip on vehicle+time the way analytics does —
  /// that can only attribute incidents falling inside a BUILT trip and silently
  /// drops the rest. Both id and name are kept: the id to join on, the name
  /// because assignments change and the report must say who was driving THEN.
  driverId   String? @map("driver_id")
  driverName String? @map("driver_name")

  /// The FIRST over-limit frame, not the third. The debounce decides whether an
  /// episode is real; it does not decide when it began.
  startedAt   DateTime @map("started_at")
  /// The LAST over-limit frame. Both ends are observed fixes, so durationSec is
  /// a LOWER BOUND on the real episode, never an overstatement.
  endedAt     DateTime @map("ended_at")
  durationSec Int      @map("duration_sec")

  /// The peak OBSERVED. The median gap between fixes is 28 s, so the true peak
  /// between two of them is unknowable and the UI must not claim otherwise.
  peakKmh     Float  @map("peak_kmh")
  avgKmh      Float? @map("avg_kmh")
  /// The limit that was broken, resolved once at capture by overspeedLimitFor.
  /// STORED rather than re-derived at read time: OVERSPEED_LIMIT_BY_TYPE is a
  /// deploy-time string, and re-reading it would silently restate history after
  /// somebody changes it.
  limitKmh    Float  @map("limit_kmh")
  /// 'type' when OVERSPEED_LIMIT_BY_TYPE matched, 'fleet' for the default.
  limitSource String @map("limit_source")
  /// peakKmh - limitKmh, stored so "worst offender" needs no expression index.
  overByKmh   Float  @map("over_by_kmh")
  /// Over-limit frames in the episode — the confidence column, shown in the UI.
  /// Three frames at a 28 s cadence is about a minute of evidence.
  frames      Int

  /// Haversine along the over-limit fixes. NULL when a fix lacked coordinates
  /// or a gap exceeded EPISODE_MAX_GAP_MS — a distance measured across a
  /// twenty-minute hole is fiction, and a null the UI renders as "—" is better
  /// than a plausible lie.
  distanceM Int?   @map("distance_m")
  startLat  Float? @map("start_lat")
  startLng  Float? @map("start_lng")
  peakLat   Float? @map("peak_lat")
  peakLng   Float? @map("peak_lng")
  endLat    Float? @map("end_lat")
  endLng    Float? @map("end_lng")

  /// fleetDayKey(startedAt) — the FLEET day, same convention as
  /// vehicle_daily_stats.day. Lets the rollup be a plain GROUP BY and keeps the
  /// month filter off date_trunc(… AT TIME ZONE) in the hot path.
  day       DateTime @db.Date
  /// { closedBy: 'falling-edge' | 'timeout' | 'shutdown', gapped, driverSource }
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver       User?        @relation("SpeedingDriver", fields: [driverId], references: [id])

  /// Idempotency. startedAt is the provider's capturedAt, so two writers
  /// processing the same frame compute an identical value and the second write
  /// is a no-op rather than a duplicate row.
  @@unique([vehicleId, startedAt])
  @@index([organisationId, startedAt]) // the glance list
  @@index([vehicleId, startedAt]) // the per-unit detail table
  @@index([organisationId, day]) // the rollup job
  @@index([driverId, startedAt]) // driver conduct
  @@map("speeding_incidents")
}

/// One sensor fault, from the moment the data showed it to the moment it
/// cleared.
///
/// This is the only durable record of a fault anywhere in the system: the live
/// detector (dash/src/hooks/useSensorHealth) is a browser memo whose
/// `detectedAt` is when the PAGE RENDERED, and connection-state is deliberately
/// an in-memory map. Neither can answer "when did it start".
model SensorFaultEpisode {
  id             String @id @default(cuid())
  organisationId String @map("organisation_id")
  vehicleId      String @map("vehicle_id")

  /// transit_no_engine | speed_no_engine | frozen_gps | low_accuracy |
  /// signal_lost | gps_not_reporting | ignition_not_reporting |
  /// odometer_not_reporting | engine_hours_not_reporting | fuel_probe_dead
  kind     String
  severity String
  /// 'poller' (frame-driven) or 'sweep' (absence-driven). Decides which
  /// detector may close the episode — a silent unit emits no frames at all, so
  /// only a sweep can open its signal_lost, and only a frame can close it.
  source   String

  /// What the DATA shows, never sweep time: movement.since for
  /// transit_no_engine, lastReportedAt for signal_lost, that channel's own
  /// lastSeenAt for a channel death.
  startedAt   DateTime  @map("started_at")
  /// First observation that no longer shows the fault. Null = still open.
  recoveredAt DateTime? @map("recovered_at")
  /// Last observation that still SAW it — the watchdog clock, so a unit that
  /// vanishes mid-episode can be closed honestly rather than left open forever.
  lastSeenAt  DateTime  @map("last_seen_at")
  durationSec Int?      @map("duration_sec")

  detail       String
  observations Int      @default(1)
  /// { speedKmh, movingSinceMs, accuracyM, channel, lastValueAt }
  evidence     Json?

  /// Where the unit was when this sensor was last working — the last fix at or
  /// before `startedAt`, copied here at open time. Null when no fix survives:
  /// vehicle_telemetries is swept at 30 days and a unit dark since last year
  /// has none left, which is exactly why the position is copied rather than
  /// looked up at read time.
  /// When that fix was taken. NOT a copy of `startedAt`: they coincide for a
  /// silent tracker, and for a channel death the newest position at or before
  /// the fault can be minutes older than the fault itself.
  lastFixAt    DateTime? @map("last_fix_at")
  lastLat      Float?   @map("last_lat")
  lastLng      Float?   @map("last_lng")
  /// Speed at that fix, and the MOVING verdict taken there. Stored rather than
  /// re-derived, so a later change to MOVING_THRESHOLD_KMH cannot restate what
  /// was true at the time — the same rule speeding_incidents applies to
  /// limit_kmh.
  lastSpeedKmh Float?   @map("last_speed_kmh")
  lastMoving   Boolean? @map("last_moving")
  /// Reverse-geocoded label for that fix, filled asynchronously — the geocoder
  /// is rate-limited and must not sit in the path of fault capture. Null means
  /// unresolved, never "nowhere".
  lastPlace    String?  @map("last_place")

  day          DateTime @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, kind, startedAt])
  @@index([organisationId, startedAt])
  @@index([vehicleId, startedAt])
  /// "what is broken right now" — the tab badge.
  @@index([organisationId, kind, recoveredAt])
  @@index([organisationId, day])
  @@map("sensor_fault_episodes")
}

/// Per-unit-per-day incident counts, so month-over-month survives the 90-day
/// detail retention.
///
/// Deliberately NOT columns on vehicle_daily_stats: that table is rebuilt
/// destructively (deleteMany by day, then createMany), so sharing it would
/// force the two rollups into one job or let them clobber each other.
model VehicleIncidentDailyStat {
  id             String   @id @default(cuid())
  vehicleId      String   @map("vehicle_id")
  /// Denormalised so the month query needs no join to vehicles.
  organisationId String   @map("organisation_id")
  day            DateTime @db.Date

  speedingCount     Int    @default(0) @map("speeding_count")
  speedingPeakKmh   Float? @map("speeding_peak_kmh")
  /// Sum of episode durationSec.
  ///
  /// This does NOT break vehicle_daily_stats' "counts, never durations" rule.
  /// That rule is about durations INFERRED from irregular sampling (fixes times
  /// an assumed interval), which once produced 103 idle hours inside a 24-hour
  /// day. This is the sum of measured intervals between two real fixes — exact
  /// as far as it goes, and an understatement of the true time over the limit.
  speedingSeconds   Int    @default(0) @map("speeding_seconds")
  speedingDistanceM Int    @default(0) @map("speeding_distance_m")

  faultCount   Int   @default(0) @map("fault_count")
  faultSeconds Int   @default(0) @map("fault_seconds")
  /// { transit_no_engine: 2, signal_lost: 1 }
  faultByKind  Json? @map("fault_by_kind")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// One row per unit per day — the job upserts on it, so a re-run repairs a
  /// day rather than doubling it.
  @@unique([vehicleId, day])
  /// The report reads a date RANGE across one org, so org+day leads.
  @@index([organisationId, day])
  @@map("vehicle_incident_daily_stats")
}

// ---------------------------------------------------------------------------
// STORAGE — sugar silos / warehouses (source of the "sugar in storage" KPI)
// ---------------------------------------------------------------------------

/// A physical sugar storage silo / warehouse operated by the organisation.
/// storedTonnes is the current stock; fill ratio drives the ok/warning/critical
/// status shown in the dashboard header. Updated by intake/dispatch operations
/// (seeded for the demo; a real deployment would mutate storedTonnes on
/// weighbridge intake and depot dispatch events).
model Silo {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  name           String // "Sukari HQ Silo 1"
  code           String // stable per-org identifier — "SILO-HQ-01"
  locationName   String   @map("location_name") // "Sukari Industries, Kakamega"
  lat            Float
  lng            Float
  capacityTonnes Float    @map("capacity_tonnes")
  storedTonnes   Float    @map("stored_tonnes")
  sugarType      String   @map("sugar_type") // RAW | PROCESSED
  status         String   @default("ok") // ok | warning | critical
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("silos")
}

// ---------------------------------------------------------------------------
// EVENTS — high-volume transactional tables (partition by began_at in Postgres)
// ---------------------------------------------------------------------------

/// One recorded journey: a vehicle moving from A to B.
model Trip {
  id                      String   @id @default(cuid())
  vehicleId               String   @map("vehicle_id")
  driverId                String?  @map("driver_id") // nullable — may be unassigned
  reportingPeriodId       String   @map("reporting_period_id")
  routeId                 String?  @map("route_id") // NULL = ad-hoc / unplanned trip
  /// The completed dispatch this trip was measured from, when it came from one.
  /// UNIQUE, so the builder can be re-run over any window without duplicating —
  /// the same idempotency the fuel sync gets from matching. NULL for trips from
  /// any other source (the retired simulator's rows, the REST create endpoint).
  dispatchId              String?  @unique @map("dispatch_id")
  beganAt                 DateTime @map("began_at")
  endedAt                 DateTime @map("ended_at")
  initialLocation         String?  @map("initial_location")
  finalLocation           String?  @map("final_location")
  durationSeconds         Int      @map("duration_seconds") // store as int, format in app
  mileageKm               Float    @map("mileage_km")
  avgSpeedKmh             Float?   @map("avg_speed_kmh")
  maxSpeedKmh             Float?   @map("max_speed_kmh")
  engineHoursSeconds      Int?     @map("engine_hours_seconds")
  consumedMl              Int?     @map("consumed_ml") // millilitres as int — no float drift
  consumedByFlsMl         Int?     @map("consumed_by_fls_ml")
  ratesDeviationByFls     Float?   @map("rates_deviation_by_fls")
  avgConsumptionL100km    Float?   @map("avg_consumption_l100km")
  avgConsumptionByFls     Float?   @map("avg_consumption_by_fls")
  avgIdleConsumptionByFls Float?   @map("avg_idle_consumption_by_fls")
  avgMileagePerUnitFls    Float?   @map("avg_mileage_per_unit_fls")
  initialFuelLevelMl      Int?     @map("initial_fuel_level_ml")
  finalFuelLevelMl        Int?     @map("final_fuel_level_ml")
  maxFuelLevelMl          Int?     @map("max_fuel_level_ml")
  minFuelLevelMl          Int?     @map("min_fuel_level_ml")

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  driver          User?           @relation("TripDriver", fields: [driverId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  route           Route?          @relation(fields: [routeId], references: [id])
  cargoManifest   CargoManifest?

  @@index([vehicleId, beganAt])
  @@index([driverId, beganAt])
  @@index([reportingPeriodId])
  @@index([routeId])
  @@index([beganAt]) // partition key for future Postgres range partitioning
  @@map("trips")
}

/// Engine-on session: captures idle vs in-motion time, useful for machinery without trips.
model EngineHourSession {
  id                        String   @id @default(cuid())
  vehicleId                 String   @map("vehicle_id")
  reportingPeriodId         String   @map("reporting_period_id")
  beganAt                   DateTime @map("began_at")
  endedAt                   DateTime @map("ended_at")
  initialLocation           String?  @map("initial_location")
  finalLocation             String?  @map("final_location")
  engineHoursSeconds        Int      @map("engine_hours_seconds")
  initialEngineHoursSeconds Int?     @map("initial_engine_hours_seconds")
  finalEngineHoursSeconds   Int?     @map("final_engine_hours_seconds")
  totalTimeSeconds          Int      @map("total_time_seconds")
  offTimeSeconds            Int?     @map("off_time_seconds")
  inMotionSeconds           Int?     @map("in_motion_seconds")
  idlingSeconds             Int?     @map("idling_seconds")
  mileageKm                 Float?   @map("mileage_km")
  avgSpeedKmh               Float?   @map("avg_speed_kmh")
  maxSpeedKmh               Float?   @map("max_speed_kmh")
  consumedMl                Int?     @map("consumed_ml")
  consumedByFlsMl           Int?     @map("consumed_by_fls_ml")
  consumedFlsMotionMl       Int?     @map("consumed_fls_motion_ml")
  consumedFlsIdleMl         Int?     @map("consumed_fls_idle_ml")
  avgConsumptionByFls       Float?   @map("avg_consumption_by_fls")
  avgConsumptionFlsMotion   Float?   @map("avg_consumption_fls_motion")
  avgConsumptionFlsIdle     Float?   @map("avg_consumption_fls_idle")
  avgConsumptionFlsTrips    Float?   @map("avg_consumption_fls_trips")
  initialFuelLevelMl        Int?     @map("initial_fuel_level_ml")
  finalFuelLevelMl          Int?     @map("final_fuel_level_ml")
  maxFuelLevelMl            Int?     @map("max_fuel_level_ml")
  minFuelLevelMl            Int?     @map("min_fuel_level_ml")

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  @@index([vehicleId, beganAt])
  @@index([reportingPeriodId])
  @@index([beganAt])
  @@map("engine_hour_sessions")
}

/// A completed scheduled service — one row per real MAINTENANCE-phase
/// completion in the simulator (see raifactorysuite.simulator.ts's `eventServiceCompleted`).
/// This is the durable record the Maintenance page's per-vehicle service
/// history report reads from; nothing here is derived/fabricated at read time.
model VehicleServiceRecord {
  id                   String   @id @default(cuid())
  vehicleId            String   @map("vehicle_id")
  servicedAt           DateTime @map("serviced_at")
  odometerKm           Float    @map("odometer_km")
  previousServiceOdoKm Float?   @map("previous_service_odo_km") // null for a vehicle's first recorded service
  nextServiceOdoKm     Float    @map("next_service_odo_km")
  createdAt            DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, servicedAt])
  @@map("vehicle_service_records")
}

/// A vehicle redirected to a third-party garage because its service came due
/// while out on the road (see the simulator's TO_GARAGE/AT_GARAGE phases).
/// Distinct from VehicleServiceRecord: this tracks the actual garage visit
/// (where, when in, when out, what was worked on), not just the odometer
/// cycle bookkeeping.
model VehicleGarageVisit {
  id              String   @id @default(cuid())
  vehicleId       String   @map("vehicle_id")
  garageName      String   @map("garage_name")
  garageLat       Float    @map("garage_lat")
  garageLng       Float    @map("garage_lng")
  enteredAt       DateTime @map("entered_at")
  exitedAt        DateTime @map("exited_at")
  durationMinutes Int      @map("duration_minutes")
  odometerKm      Float    @map("odometer_km")
  severityScore   Float    @map("severity_score") // 0–1
  itemsFixed      Json     @map("items_fixed") // [{ name, replaced }, ...]
  createdAt       DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, enteredAt])
  @@map("vehicle_garage_visits")
}

/// A single refuelling event.
/// One vehicle's fuel day, kept so slosh can be TRENDED rather than recomputed.
///
/// Asked for by the operator: the fluctuation a moving tank shows is mostly
/// slosh artefact, and it wants a moving average maintained "not for theft
/// detection but for trend logging".
///
/// NOTHING in modules/fuel/fuel-adjudication reads this table and nothing
/// should. The drain rules have their own probe instrument, measured while
/// PARKED (getProbeProfile). A motion-slosh average feeding a theft verdict
/// would let a machine excuse its own drains by working rough ground.
/// One vehicle's telemetry activity on one fleet day.
///
/// ## Why this table exists
///
/// The probe report classifies a unit's FLS from thirty days of behaviour, and
/// it used to derive that by aggregating `vehicle_telemetries` directly. That
/// query cost 10.4 s and could not be indexed out of trouble: a retention
/// policy keeps the telemetry table at roughly thirty days, so the window
/// predicate removed 134 rows out of 9,225,230 and the scan had to touch
/// essentially every row. `EXPLAIN` on 2026-08-20 showed 176,073 blocks read
/// against 8,731 cached — 1,375 MB pulled through an 88 MB `shared_buffers`,
/// 21 s of I/O wait across three parallel workers.
///
/// A covering index would have shifted about a quarter of those bytes for
/// 1.1 GB of storage and a write on every one of the ~400 k daily inserts. This
/// costs one row per vehicle per day — about 8,500 rows for the whole window —
/// and every figure the report needs is decomposable across days: counts sum,
/// levels and timestamps take a max.
///
/// ## What is NOT here
///
/// Anything about the last 24 hours. Those figures decide whether a channel is
/// alive RIGHT NOW, they change all day, and the report already scans that
/// window separately. A rollup of today would be stale by construction.
model VehicleDailyStat {
  id          String    @id @default(cuid())
  vehicleId   String    @map("vehicle_id")
  /// The FLEET day this describes (Kenyan, not UTC — see lib/provider-time).
  day         DateTime  @db.Date
  /// Every frame the unit sent that day, whatever it carried.
  pings       Int
  /// Frames carrying a fuel level at all — null is "the channel said nothing",
  /// which is the distinction the report's NOT_REPORTING state rests on.
  levelPings  Int       @map("level_pings")
  /// Highest level seen that day. Max across days gives the month's peak,
  /// which is what the calibration check compares a tank's capacity against.
  peakMl      Int?      @map("peak_ml")
  /// Last frame with a level ABOVE ZERO. A probe reading a flat zero all day is
  /// reporting, and is also broken; separating these two is the whole point.
  lastAliveAt DateTime? @map("last_alive_at")
  /// Last frame carrying a level at all, zero included.
  lastLevelAt DateTime? @map("last_level_at")
  /// Fixes that day with the engine running — the DENOMINATOR of the idle
  /// ratio. Zero means the engine never ran; null means the day predates these
  /// columns.
  engineFixes Int?      @map("engine_fixes")
  /// Of those, the ones the unit was not moving for.
  ///
  /// A COUNT, and never converted to a duration here. The sampling interval is
  /// irregular — p50 28 s, p99 905 s — so fixes times an assumed interval is
  /// wrong, and gave 103 idle hours inside a 24-hour day once already. The
  /// ratio idleFixes/engineFixes is exact whatever the interval does, and
  /// fuel_daily_trends.engineSeconds supplies the scale.
  idleFixes   Int?      @map("idle_fixes")
  /// Ground the machine worked that day, square metres — an UPPER BOUND, never
  /// a survey.
  ///
  /// Two machine families, two geometries, one column, because both answer the
  /// same question:
  ///
  /// - **Excavators** — a union of 8 m discs around distinct snapped positions.
  ///   The arm sweeps around a body that stays put, so the body is what to
  ///   buffer.
  /// - **Dozers** (since 2026-08-28) — a union of 1.5 m buffers along the
  ///   SEGMENTS between consecutive fixes. A dozer travels, so at ~10 m between
  ///   fixes the point method would give disconnected discs with holes between
  ///   them. See analytics/dozer-area.service.
  ///
  /// Null everywhere else, and null on a machine whose day was too thin to
  /// draw. Stored rather than computed on demand because the geometry cannot be
  /// done inside an API request: measured 2026-08-20, one excavator's day took
  /// 19 s to read and union, and there are nineteen of them.
  ///
  /// Neither figure has been validated against a block of known extent, and
  /// neither can tell working ground from ground merely crossed — a dozer
  /// tramming between cuts is counted as if it were cutting. `MUFINDI: DZ 09`
  /// measured 4.24 ha per engine hour against a 3 m blade's theoretical 0.38,
  /// which is what that looks like.
  digAreaM2   Int?      @map("dig_area_m2")
  /// Seconds the machine spent over that ground — the denominator of the
  /// m2-per-hour rate, integrated the same way engineSeconds is. Digging for an
  /// excavator; for a dozer, the time inside the segments that were counted.
  digSeconds  Int?      @map("dig_seconds")
  computedAt  DateTime  @default(now()) @map("computed_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// One row per unit per day — the job upserts on it, so a re-run repairs a
  /// day rather than doubling it.
  @@unique([vehicleId, day])
  /// The report reads a date RANGE across all vehicles, so day leads.
  @@index([day])
  @@map("vehicle_daily_stats")
}

model FuelDailyTrend {
  id               String   @id @default(cuid())
  vehicleId        String   @map("vehicle_id")
  /// The FLEET day this describes (Kenyan, not UTC — see lib/provider-time).
  day              DateTime @db.Date
  /// Closing level of the previous day; equals that day's closingMl.
  openingMl        Int?     @map("opening_ml")
  closingMl        Int?     @map("closing_ml")
  /// opening − closing. Not "burned" on a day carrying a refuel.
  consumedMl       Int?     @map("consumed_ml")
  /// Moving average of per-RUN slosh while in motion, over the last
  /// TURBULENCE_STOPS runs WHEREVER THEY FELL — the window crosses midnight.
  /// Slosh, not fuel moved. Formula at stopTurbulence in fuel-tank-state.
  turbulenceMl     Int?     @map("turbulence_ml")
  /// Ground covered that day, in metres — summed from the position fixes,
  /// since vehicle_telemetries carries no odometer. Metres because an integer
  /// of them is exact where a float of kilometres accumulates error.
  distanceM        Int?     @map("distance_m")
  /// Fuel the engine is EXPECTED to have burned over that distance, at
  /// KM_PER_LITRE. An expectation, not a measurement — compare against
  /// consumedMl, which is what the tank actually did.
  ///
  /// The DISTANCE half of the pair. engineBurnMl is the other, and is the
  /// better basis for the 215 of 310 probed units that are plant or tractors.
  expectedBurnMl   Int?     @map("expected_burn_ml")
  /// The unit's cumulative ENGINE-HOUR METER at the end of that day — the
  /// machine's own counter, the way an odometer reads, NOT hours run that day.
  /// From Wialon's cneh, which arrives in the raw payload rather than as a
  /// column. Null for the ~26% of units whose tracker never reports it.
  ///
  /// The READING, not the day-over-day delta: the adapter carries the last
  /// known value forward, so a delta between two boundary reads can
  /// misattribute hours across days.
  engineHoursMeter Float?   @map("engine_hours_meter")
  /// Seconds the engine ran that day, integrated from every fix and capped at
  /// MAX_ENGINE_GAP_SECONDS per gap. A measurement, not an estimate.
  engineSeconds    Int?     @map("engine_seconds")

  /// Fuel expected to have burned over those hours, at the vehicle's measured
  /// litres-per-hour (vehicle_fuel_rates, falling back to its org+type median).
  /// The ENGINE half of the pair, and the primary basis for every type —
  /// position freezes at speed 0, so a working excavator covers no ground.
  /// Null, never zero, when the machine and its type have no measured rate.
  engineBurnMl   Int?     @map("engine_burn_ml")
  /// Stops under HEAVY_STOP_MINUTES — a pause in the work.
  temporaryStops Int      @default(0) @map("temporary_stops")
  /// Stops of HEAVY_STOP_MINUTES or more — the machine standing down.
  heavyStops     Int      @default(0) @map("heavy_stops")
  /// This day's individual run slosh values, in order, one per run.
  ///
  /// Kept because a moving average that spans days needs the runs themselves —
  /// a day's mean cannot be un-meaned. Most days hold one or two.
  runSloshMl     Int[]    @map("run_slosh_ml")
  /// STOPS the moving average spans, so a one-run figure is not read as
  /// confidently as an eight-run one. See stopTurbulence for the formula.
  stopsAveraged  Int      @default(0) @map("stops_averaged")
  computedAt     DateTime @map("computed_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, day])
  @@index([vehicleId, day(sort: Desc)])
  @@index([day])
  @@map("fuel_daily_trends")
}

/// What one vehicle burns per engine-hour, derived from its own telemetry.
///
/// Method, measured values and caveats: docs/fuel-consumption-rates.md. Rates
/// come from engine-on RUNS with no filling and no drain inside them — never
/// from per-ping deltas, which accumulate probe noise into fictional
/// consumption — and are refreshed weekly rather than on the request path,
/// because the derivation sorts the full fuel-carrying telemetry window on an
/// instance with ~1 GB of RAM.
///
/// A vehicle under fuel-rate.MIN_RUNS falls back to its org+type MEDIAN. Not
/// the fleet aggregate: that is volume-weighted, and Kasulu TRACTOR reads
/// 12.47 L/h aggregated against a per-vehicle median of 3.51.
///
/// Feeds expectations only. Nothing that judges a fuel event reads this.
model VehicleFuelRate {
  id           String            @id @default(cuid())
  vehicleId    String            @unique @map("vehicle_id")
  /// Litres per engine-hour. Always derived, and the figure a judgement uses
  /// whenever `primaryBasis` is HOURS — or when a DISTANCE machine is judged on
  /// a fall during which it did not travel. Never null: the derivation cannot
  /// produce a run without engine time.
  lPerHour     Float             @map("l_per_hour")
  /// Litres per kilometre. The PRIMARY figure where `primaryBasis` is DISTANCE,
  /// not the garnish this comment used to call it.
  ///
  /// Still meaningless on plant, which measured 7.361 L/km at 1.5 km/h, and
  /// still null for anything the window gave no distance. `resolveBand` inverts
  /// it to km/L and discards the result below ROAD_MIN_KM_PER_L, so a machine
  /// that crawls gets no distance baseline however road-like its type.
  ///
  /// Measured 2026-08-27: 52 of the 55 DISTANCE machines holding their own rate
  /// clear that floor, at 1.5-15.2 km/L. The binding constraint is not the
  /// floor, it is rate coverage — only 55 of 207 DISTANCE machines have a rate
  /// of their own at all, which is RATE_WINDOW_DAYS' three-day window.
  lPerKm       Float?            @map("l_per_km")
  /// Which of the two figures above is this machine's real one, per
  /// `resolveBasis`. Null on rows derived before 2026-08-27; the weekly
  /// derivation fills it in. Nothing infers a default from null — a missing
  /// basis means "not yet resolved", and HOURS is a claim, not a fallback.
  primaryBasis ConsumptionBasis? @map("primary_basis")
  /// Litres per engine-hour with the machine RUNNING BUT DOING NOTHING —
  /// stationary, engine on, and not having moved a half-metre grid cell.
  ///
  /// Split out because blending it with working burn is a large part of the
  /// 2-4x within-type spread. Measured 2026-08-27 over 7 days, working burn is
  /// 1.85x idle across all HOURS machines, and per class: TRACTOR_MEDIUM 7.22x
  /// (0.8 vs 6.1), TRACTOR_SMALL 2.75x, EXCAVATOR_LARGE 2.33x (6.7 vs 15.7).
  ///
  /// Null wherever the window gave too few runs of that kind — a machine that
  /// never idled has no idle rate, and inventing one from its working figure
  /// would be the fabrication these columns exist to end. Only meaningful for
  /// HOURS machines; a road vehicle's idling is measured the same way but its
  /// primary basis is distance.
  idleLPerHour Float?            @map("idle_l_per_hour")
  /// Litres per engine-hour while MOVING, or stationary and changing position —
  /// digging, slewing, loading. See idleLPerHour for the split's evidence.
  workLPerHour Float?            @map("work_l_per_hour")
  /// Qualifying runs behind each split figure, so a thin one is visible rather
  /// than merely present. Counted separately because a machine can have plenty
  /// of one kind and almost none of the other — 73 idle runs against 708
  /// working on TRACTOR_MEDIUM.
  idleRuns     Int?              @map("idle_runs")
  workRuns     Int?              @map("work_runs")
  /// Qualifying runs behind the figure. Below MIN_RUNS it is not used.
  runs         Int
  /// Days of telemetry the derivation read, so a rate carries its own window.
  windowDays   Int               @map("window_days")
  derivedAt    DateTime          @map("derived_at")

  /// The tank-balance measurement from `fuel-burn-rate.service`, which closes
  /// `burn = (opening - closing) + refills - drains` over 30 fleet-days and is
  /// display-only today. Persisted here so `resolveBand` can prefer it over the
  /// weaker three-day derivation — see the plan's 3.6 precedence.
  ///
  /// UNPOPULATED until the measured pipeline is wired to write them. A reader
  /// must treat null as "not measured" and fall through, never as zero.
  measuredLPerHour   Float?    @map("measured_l_per_hour")
  /// The range the qualifying days span, mirroring MeasuredBurnRate's lo/hi.
  measuredLoLPerHour Float?    @map("measured_lo_l_per_hour")
  measuredHiLPerHour Float?    @map("measured_hi_l_per_hour")
  /// The distance sibling of the balance above — awaits the plausibility filter
  /// on `coveredSince`, without which inflated km deflate L/km and hide loss.
  measuredLPerKm     Float?    @map("measured_l_per_km")
  /// Qualifying DAYS behind the measured figures, against `runs` for the
  /// derived ones. Different denominators, deliberately not sharing a column.
  measuredDays       Int?      @map("measured_days")
  measuredAt         DateTime? @map("measured_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("vehicle_fuel_rates")
}

model FuelFilling {
  id                 String   @id @default(cuid())
  vehicleId          String   @map("vehicle_id")
  reportingPeriodId  String   @map("reporting_period_id")
  filledAt           DateTime @map("filled_at")
  location           String?
  mileageAtFillKm    Float?   @map("mileage_at_fill_km")
  initialFuelLevelMl Int?     @map("initial_fuel_level_ml")
  filledMl           Int      @map("filled_ml")
  finalFuelLevelMl   Int?     @map("final_fuel_level_ml")

  /// Our verdict on the provider's claim that this was a refuelling — see
  /// FuelEventVerdict and modules/fuel/fuel-filling-adjudication. Rows stay on
  /// the ledger whatever the verdict, so the rule can always be audited back.
  verdict           FuelEventVerdict @default(PENDING)
  verdictAt         DateTime?        @map("verdict_at")
  verdictReason     String?          @map("verdict_reason")
  /// Millilitres our OWN telemetry saw arrive. `filledMl` is left exactly as
  /// the provider reported it, so the two can always be compared; on 210 rows
  /// this is zero or negative against a positive claim.
  observedRiseMl    Int?             @map("observed_rise_ml")
  /// How sure we are the VERDICT is right, 0-1 — not how sure fuel was really
  /// added, and not a finer-grained restatement of `verdict`/`verdictReason`.
  /// Null wherever `verdict` is PENDING; every settled row carries a number.
  /// See fuel-adjudication.ts's Adjudication.confidence for the full
  /// reasoning and modules/fuel/fuel-adjudication.service.ts's
  /// bufferConfidence/getBufferedConfidence for the in-memory stage this
  /// replaces — the sweep does not populate this column until it is wired up.
  verdictConfidence Float?           @map("verdict_confidence")

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  @@index([vehicleId, filledAt])
  @@index([reportingPeriodId])
  @@index([filledAt])
  /// Drives the adjudication sweep.
  @@index([verdict, filledAt])
  @@map("fuel_fillings")
}

/// A detected anomalous fuel-level drop (suspected theft or siphoning).
model FuelTheft {
  id                 String   @id @default(cuid())
  vehicleId          String   @map("vehicle_id")
  driverId           String?  @map("driver_id") // nullable — vehicle may be unattended
  reportingPeriodId  String   @map("reporting_period_id")
  beganAt            DateTime @map("began_at")
  detectedAt         DateTime @map("detected_at")
  initialLocation    String?  @map("initial_location")
  initialFuelLevelMl Int?     @map("initial_fuel_level_ml")
  finalFuelLevelMl   Int?     @map("final_fuel_level_ml")
  stolenMl           Int      @map("stolen_ml")
  initialSpeedKmh    Float?   @map("initial_speed_kmh") // 0 = stationary drain
  finalSpeedKmh      Float?   @map("final_speed_kmh")

  /// Our verdict on the provider's claim — see FuelEventVerdict and
  /// modules/fuel/fuel-adjudication. Rows stay on the ledger whatever the
  /// verdict, so the rule can always be audited back against Wialon.
  verdict           FuelEventVerdict @default(PENDING)
  verdictAt         DateTime?        @map("verdict_at")
  /// Millilitres of the observed drop that came back, from our own telemetry.
  recoveredMl       Int?             @map("recovered_ml")
  /// Short slug naming which rule decided it, for auditing.
  verdictReason     String?          @map("verdict_reason")
  /// How sure we are the VERDICT is right, 0-1 — see the identical field on
  /// FuelFilling for the full reasoning. Null wherever `verdict` is PENDING.
  verdictConfidence Float?           @map("verdict_confidence")

  /// WHY the fuel left, for rows the verdict settled as DRAIN — see
  /// FuelDrainCause and modules/fuel/fuel-theft-classifier. Null on rows that
  /// never reached a drain verdict, and on every row written before this
  /// existed.
  drainCause      FuelDrainCause? @map("drain_cause")
  /// How sure we are the CAUSE is right, 0-1. Distinct from
  /// `verdictConfidence`, which grades a different decision.
  causeConfidence Float?          @map("cause_confidence")
  /// Short slug naming which cause rule decided, for auditing.
  causeReason     String?         @map("cause_reason")

  /// The MEASURED shape of the fall this verdict was reached on — see
  /// DropEvidence in modules/fuel/fuel-drop-shape.
  ///
  /// Computed for every drain since the classifier was written and then thrown
  /// away: only the cause slugs survived, and `impliedLph` lived on solely as
  /// text inside a notification string. That made every backtest impossible to
  /// run and every labelled event impossible to explain — a reviewer asked "why
  /// was this called a siphon" could be shown a slug and nothing else.
  ///
  /// Null on rows judged before 2026-08-28, and null wherever the fall could
  /// not be measured at all. Never back-computed: the telemetry a drain was
  /// judged on may have changed since, and a figure derived now would describe a
  /// different fall from the one the verdict was about.
  ///
  /// `fallSeconds` also fixes DriverIncident.minutes, which reports
  /// `detectedAt - beganAt` — the PROVIDER's window, the very quantity
  /// PLATEAU_TOLERANCE exists to reject, and typically several times the real
  /// fall.
  fallSeconds    Int?   @map("fall_seconds")
  /// Baseline to trough in millilitres, from the SMOOTHED series. Distinct from
  /// `stolenMl`, which is the provider's claim; the two disagreeing is itself
  /// evidence and the pair must stay comparable.
  measuredDropMl Int?   @map("measured_drop_ml")
  /// Engine-on seconds inside the fall, and the share of its readings carrying
  /// a MEASURED ignition rather than the speed fallback. The second number is
  /// what says whether the first can be trusted.
  engineSeconds  Int?   @map("engine_seconds")
  engineEvidence Float? @map("engine_evidence")
  /// Largest single-interval drop over the total. A siphon is one step; a burn
  /// is many.
  stepFraction   Float? @map("step_fraction")
  /// Litres per hour the fall implies. The figure the band is compared against,
  /// and until now it existed only inside a sentence.
  impliedLph     Float? @map("implied_lph")
  /// Kilometres covered during the fall, integrated from reported speed. Zero
  /// and null mean different things — see DropEvidence.distanceKm.
  fallDistanceKm Float? @map("fall_distance_km")

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  driver          User?           @relation("TheftDriver", fields: [driverId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  @@index([vehicleId, beganAt])
  @@index([reportingPeriodId])
  @@index([beganAt])
  /// Drives the adjudication sweep: "which drains are still PENDING and old
  /// enough to judge?"
  @@index([verdict, detectedAt])
  /// Drives the dashboard's red-vehicle lookup: "which vehicles have an
  /// announced cause inside the recency window?" Leads on `drainCause`
  /// because only two of its seven values are ever asked for, so the scan
  /// starts from a small slice of the table rather than from a date range
  /// covering every drain in it.
  @@index([drainCause, beganAt])
  @@map("fuel_thefts")
}

/// What a human decided a fuel event actually was.
///
/// The only external check this detector has. Every threshold in the classifier
/// is currently an ALERT-VOLUME choice rather than an accuracy one, because
/// nothing says which flagged events were real: measured over 30 days, median
/// excess sits flat at 29-31 L from 1.5x to 50x, so no value on that axis buys
/// better targeting. The same gap blocks two further decisions — whether the
/// measured tank balance should outrank the derived rate in `resolveBand`, and
/// whether the 16 SUKARI announcements the consumption-basis change retired
/// were true or false.
///
/// Twenty to thirty adjudicated events is enough to state precision for the
/// first time.
///
/// Kept in its OWN table rather than as columns on the event, for two reasons.
/// A label is an opinion with an author and a date, and two reviewers may
/// disagree — which is data, not a conflict to resolve by overwriting. And the
/// event rows are rewritten by the adjudication sweep, so a label living on one
/// would be at the mercy of a re-judge.
model FuelEventLabel {
  id         String              @id @default(cuid())
  /// The event this describes. `eventType` says which table `eventId` points
  /// into — `fuel_thefts` or `fuel_fillings`.
  ///
  /// Deliberately NOT a foreign key. Postgres cannot express "FK only when the
  /// discriminator says so", so an FK to fuel_thefts would reject every FILLING
  /// label. A pair of nullable FK columns would buy referential integrity at the
  /// cost of every reader coalescing two columns and every writer keeping them
  /// exclusive; the import CLI resolves the id against the right table instead.
  eventId    String              @map("event_id")
  eventType  FuelEventType       @map("event_type")
  label      FuelEventLabelValue
  /// Who decided. Free text rather than a user FK: the reviewer is usually an
  /// operations person working from a spreadsheet, not a system account, and
  /// inventing a User row for them would put fiction in the roster.
  labelledBy String              @map("labelled_by")
  labelledAt DateTime            @default(now()) @map("labelled_at")
  /// Why. The most valuable column here when a label disagrees with the
  /// verdict, and the only place a reviewer can say "the driver admitted it"
  /// or "this probe is known bad".
  note       String?

  /// One label per reviewer per event. A reviewer correcting themselves updates
  /// rather than accumulating, while two reviewers both keep their answer.
  @@unique([eventId, eventType, labelledBy])
  @@index([eventType, label])
  @@map("fuel_event_labels")
}

/// A reviewer's verdict on an event.
///
/// UNSURE is a first-class answer and not a missing one. A reviewer forced to
/// choose between THEFT and NOT_THEFT on an event they cannot call will guess,
/// and a guessed label is worse than no label — it enters the precision
/// arithmetic carrying the same weight as a certain one. The scoring excludes
/// UNSURE from precision and reports its share separately, because a detector
/// producing events nobody can adjudicate is telling you something too.
enum FuelEventLabelValue {
  THEFT
  NOT_THEFT
  UNSURE
}

// ---------------------------------------------------------------------------
// LIVE TELEMETRY — high-frequency device pings
// ---------------------------------------------------------------------------

/// One positional/state snapshot pushed by the GPS/FLS device.
///
/// Performance design decisions:
///   • BigInt autoincrement PK — sequential inserts pack the B-tree efficiently;
///     CUID would scatter and fragment the index at millions of rows/day.
///   • @@unique([deviceId, capturedAt]) — idempotent ingest; vendor platform
///     retries never create duplicate rows.
///   • driverId denormalised — avoids a point-in-time join through VehicleAssignment
///     on every telemetry read. Resolved once at ingest time.
///   • rawPayload NOT stored here — moved to VehicleTelemetryRaw (separate table)
///     to keep this hot table narrow and cache-friendly.
///   • Geofence evaluation is NEVER run on this insert path; it is enqueued as a
///     BullMQ job and processed asynchronously by the geofence worker.
/// What the provider says is FITTED to a unit, as opposed to what the unit has
/// lately reported.
///
/// The two are different questions and the fleet needs both. Telemetry history
/// answers "is this channel alive"; only the provider's sensor configuration
/// answers "is there anything there to be alive". Without this table a fuel
/// channel that reports nothing is indistinguishable from one that was never
/// installed, and the operator cannot tell a probe to service from a Wialon
/// record to correct.
///
/// ## Why calibrationPoints is the field that matters
///
/// A Wialon fuel sensor converts a raw parameter to litres through a
/// calibration table. `wialon.sensors.calibrateFuel` returns null when that
/// table is empty, and `readFuelProbeFault` skips such a sensor entirely — so a
/// unit whose sensor exists but carries no table produces no level and no
/// fault. It is silently invisible, and it is a configuration error rather than
/// a hardware one. Zero here names that case.
///
/// Refreshed wholesale by the sensor sync; rows are provider state, never
/// edited by hand.
model VehicleSensor {
  id                String   @id @default(cuid())
  vehicleId         String   @map("vehicle_id")
  /// The sensor's own id within the unit, as the provider numbers it.
  externalId        String   @map("external_id")
  /// The provider's label, e.g. "Fuel level" or "22.BLE Probe Status".
  name              String
  /// Provider sensor type, e.g. "fuel level", "engine operation".
  type              String
  /// The parameter it reads, e.g. "io_270". Two sensors can share one.
  parameter         String
  /// Points in the calibration table. ZERO means it cannot produce a value.
  calibrationPoints Int      @map("calibration_points")
  /// Highest raw value the table covers — above it a reading is a fault code,
  /// not a measurement. Null when there is no table.
  calibratedMax     Float?   @map("calibrated_max")
  firstSeenAt       DateTime @default(now()) @map("first_seen_at")
  syncedAt          DateTime @updatedAt @map("synced_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, externalId])
  @@index([vehicleId])
  /// "every unit carrying a fuel sensor, calibrated or not" — the report's
  /// leading question.
  @@index([type, calibrationPoints])
  @@map("vehicle_sensors")
}

model VehicleTelemetry {
  id         BigInt   @id @default(autoincrement())
  vehicleId  String   @map("vehicle_id")
  deviceId   String   @map("device_id") // denormalised — no join needed on ingest
  driverId   String?  @map("driver_id") // denormalised — active driver at ping time
  capturedAt DateTime @map("captured_at") // device timestamp (NOT server receipt time)
  receivedAt DateTime @default(now()) @map("received_at")

  // Position
  lat        Float?
  lng        Float?
  altitudeM  Float? @map("altitude_m")
  headingDeg Float? @map("heading_deg") // 0-360 compass bearing
  accuracyM  Float? @map("accuracy_m") // GPS horizontal accuracy in metres

  // Motion & engine
  speedKmh Float?  @map("speed_kmh") // instantaneous GPS speed
  engineOn Boolean @default(false) @map("engine_on") // digital I/O pin state

  /// Was `engineOn` MEASURED, or inferred from movement?
  ///
  /// The adapter fills `engineOn` as `ignition ?? (speed > 0)`, so on a unit
  /// whose ignition line reports nothing the column is a restatement of whether
  /// the vehicle MOVED — and "engine off and stationary" becomes true of every
  /// parked machine by construction. Any rule that reasons about the engine
  /// must read THIS, never `engineOn` alone.
  ///
  /// NULL means unknown, not false: it is what a row written before this column
  /// existed carries, and what an un-backfilled row carries. Test `IS TRUE`.
  ignitionKnown    Boolean?        @map("ignition_known")
  /// Where a known ignition state came from, so a method that is later
  /// disproved can be withdrawn wholesale instead of being untangled.
  ignitionSource   IgnitionSource? @map("ignition_source")
  /// The unit's own cumulative engine-hours counter at this fix (Wialon `cneh`).
  ///
  /// Present on ~96% of frames, and already the most trusted engine-time source
  /// in the codebase — validated at 0 s error for `KTCC 959G` against 664 s and
  /// 1,761 s for capped and uncapped gap integration. It was only ever persisted
  /// as a DAILY rollup on `FuelDailyTrend`, so nothing could take a per-fix
  /// delta from it.
  engineHoursMeter Float?          @map("engine_hours_meter")

  // Fuel (FLS sensor reading)
  fuelLevelMl Int? @map("fuel_level_ml") // calibrated tank level in millilitres
  fuelUsedMl  Int? @map("fuel_used_ml") // delta vs. previous ping (negative = impossible → flag)

  // Cargo weight (load-cell sensor — NULL if vehicle not fitted)
  cargoWeightKg Float? @map("cargo_weight_kg")

  /// ── On-board camera / MDVR ───────────────────────────────────────────────
  /// NULL on essentially every row, and that is expected rather than a gap:
  /// one unit of 1,496 in this Wialon account reports a recorder at all
  /// (`VS Menengai CAMERA - KCS 078M`), measured 2026-08-29.
  ///
  /// Per-fix rather than on Vehicle because all four change over time — a
  /// recorder can lose signal, fill its disk, or have its stream expire — and
  /// the fleet snapshot already reads the latest fix for exactly this kind of
  /// state (see the LATERAL join in telemetry.repository).
  ///
  /// True when the unit's own diagnostics say a recorder is fitted.
  cameraFitted     Boolean? @map("camera_fitted")
  /// Browser-openable stream URL, when one has arrived AND parsed as http(s).
  /// Never a guess: an rtsp:// or opaque value is dropped upstream rather than
  /// written here, so a non-null value is always something a client can open.
  /// See readCamera in providers/wialon/wialon.sensors.
  cameraStreamUrl  String?  @map("camera_stream_url")
  /// The recorder was recording at this fix.
  cameraRecording  Boolean? @map("camera_recording")
  /// A channel had lost video signal — the difference between "no feed because
  /// nothing is fitted" and "no feed because the lens is dead".
  cameraSignalLost Boolean? @map("camera_signal_lost")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([deviceId, capturedAt]) // idempotent ingest
  @@index([vehicleId, capturedAt]) // timeline + latest-ping (B-tree serves ASC and DESC)
  // A THIRD index exists on this table that is NOT declared here:
  //   vehicle_telemetries_moving_idx (vehicle_id, captured_at DESC)
  //     WHERE speed_kmh > 0
  // Prisma's schema language cannot express a partial index, so it lives in
  // migrations/20260801000000_telemetry_moving_partial_index. Do not "tidy it
  // up" as drift — without it the fleet snapshot's last-moved lookup scans the
  // full history of every vehicle that has never moved, and the query times
  // out. Details and measurements in that migration's header.
  @@index([capturedAt]) // partition key — range queries across all vehicles
  @@map("vehicle_telemetries")
}

/// Raw vendor payload stored separately so VehicleTelemetry stays narrow.
/// Only join this table for debugging, reprocessing, or vendor audit.
/// Linked 1-to-1 via the same BigInt id as VehicleTelemetry.
model VehicleTelemetryRaw {
  telemetryId BigInt @id @map("telemetry_id") // FK = VehicleTelemetry.id (no Prisma relation — avoid eager load)
  payload     Json // original vendor JSON/parsed binary packet

  @@map("vehicle_telemetry_raws")
}

// ---------------------------------------------------------------------------
// CARGO — manifest attached to a trip
// ---------------------------------------------------------------------------

/// Cargo declaration and load-sensor readings for a single trip.
/// declaredWeightKg comes from the waybill (manual entry at dispatch).
/// departureWeightKg / arrivalWeightKg come from load-cell sensor readings
/// pushed in VehicleTelemetry.cargoWeightKg at trip start and end.
model CargoManifest {
  id                String     @id @default(cuid())
  tripId            String     @unique @map("trip_id") // one manifest per trip
  description       String? // free-text e.g. "Maize flour 50 kg bags"
  cargoType         CargoType? @map("cargo_type") // enum — prevents "bulk" vs "BULK" drift
  declaredWeightKg  Float?     @map("declared_weight_kg") // from waybill
  departureWeightKg Float?     @map("departure_weight_kg") // sensor reading at trip start
  arrivalWeightKg   Float?     @map("arrival_weight_kg") // sensor reading at trip end
  weightVarianceKg  Float?     @map("weight_variance_kg") // computed: departure - arrival
  notes             String?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id])

  // No explicit @@index([tripId]) — @unique already creates an implicit B-tree index
  @@map("cargo_manifests")
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS — Web Push subscriptions
// ---------------------------------------------------------------------------

/// Browser Web Push subscription registered by a dashboard user.
/// Keyed by endpoint (unique per browser × origin). Stale subscriptions
/// (HTTP 410/404 from the push service) are automatically cleaned up.
model PushSubscription {
  id             String   @id @default(cuid())
  organisationId String?  @map("organisation_id")
  userId         String?  @map("user_id")
  endpoint       String   @unique // push service URL — the natural key
  p256dh         String   @map("p256dh") // ECDH public key (base64url)
  auth           String // HMAC auth secret (base64url)
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [organisationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// SUMMARY — materialised roll-up (refresh periodically, not source of truth)
// ---------------------------------------------------------------------------

/// Pre-aggregated KPIs per vehicle per reporting period.
/// Powers dashboards without scanning all event tables.
model VehiclePeriodSummary {
  id                   String   @id @default(cuid())
  vehicleId            String   @map("vehicle_id")
  reportingPeriodId    String   @map("reporting_period_id")
  mileageInTripsKm     Float?   @map("mileage_in_trips_km")
  mileageAllMessagesKm Float?   @map("mileage_all_messages_km")
  avgSpeedKmh          Float?   @map("avg_speed_kmh")
  maxSpeedKmh          Float?   @map("max_speed_kmh")
  timeInTripsSeconds   Int?     @map("time_in_trips_seconds")
  engineHoursSeconds   Int?     @map("engine_hours_seconds")
  consumedByFlsMl      Int?     @map("consumed_by_fls_ml")
  avgConsumptionByFls  Float?   @map("avg_consumption_by_fls")
  avgMileagePerUnitFls Float?   @map("avg_mileage_per_unit_fls")
  initialFuelLevelMl   Int?     @map("initial_fuel_level_ml")
  finalFuelLevelMl     Int?     @map("final_fuel_level_ml")
  totalFilledMl        Int?     @map("total_filled_ml")
  totalStolenMl        Int?     @map("total_stolen_ml")
  refreshedAt          DateTime @default(now()) @map("refreshed_at")

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  @@unique([vehicleId, reportingPeriodId])
  @@index([reportingPeriodId])
  @@map("vehicle_period_summaries")
}

// ---------------------------------------------------------------------------
// SIMULATION — persisted state for the RaiFactorySuite mock so the simulation can
// pause on server stop and resume exactly where it left off on restart.
// ---------------------------------------------------------------------------

/// One row per simulated device holding the full VehicleSimState as JSON.
/// Written each poll cycle by RaiFactorySuiteMockAdapter and read on boot to
/// hydrate the in-memory simulator. Not part of the domain model — purely an
/// implementation detail of the mock telemetry provider.
model SimulationState {
  deviceId  String   @id @map("device_id")
  orgId     String?  @map("organisation_id")
  state     Json // serialised VehicleSimState
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("simulation_states")
}

/// Single-row (id = "singleton") heartbeat used to detect how long the
/// simulation was paused between a stop and the next start.
model SimulationMeta {
  id         String   @id @default("singleton")
  lastTickAt DateTime @map("last_tick_at")
  simDayKey  String?  @map("sim_day_key")
  simClockMs BigInt?  @map("sim_clock_ms") // simulated-time epoch ms (6× real; paused across downtime)

  @@map("simulation_meta")
}

/// Operational alert raised by the RaiFactorySuite platform (dispatch/driver
/// governance: overdue tractors, driver swaps, blocked drivers, HOTO
/// discrepancies). Distinct from VehicleAlert, which is derived from OUR
/// telemetry flags and requires a vehicle: a provider alert is delivered
/// pre-composed, may concern people rather than a vehicle, and is keyed by the
/// provider's own id so a webhook redelivery is idempotent.
model ProviderAlert {
  id             String   @id @default(cuid())
  /// RaiFactorySuite alert UUID — dedupe key for webhook retries + backfill.
  externalId     String   @unique @map("external_id")
  organisationId String   @map("organisation_id")
  /// Vehicle named in the alert, when its plate resolves to our registry.
  vehicleId      String?  @map("vehicle_id")
  type           String // TRACTOR_OVERDUE, DRIVER_BLOCKED, …
  severity       String // info | warning | critical — mapped from `type`
  message        String
  /// Provider-side id of the related record (dispatch, driver, …).
  relatedId      String?  @map("related_id")
  plate          String? // plate parsed out of the message, if any
  acknowledged   Boolean  @default(false)
  createdAt      DateTime @map("created_at") // provider's timestamp
  receivedAt     DateTime @default(now()) @map("received_at")
  /// 'webhook' when pushed to us, 'backfill' when pulled by sync:alerts.
  source         String   @default("webhook")
  raw            Json?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])

  @@index([organisationId, createdAt])
  @@index([vehicleId, createdAt])
  @@map("provider_alerts")
}

/// A dispatch as RaiFactorySuite recorded it: this vehicle, this driver, sent
/// to this destination at this time.
///
/// The provider is the ONLY source of "where is it going" — it exposes no
/// coordinates, so `destination` is the dispatcher's free text and nothing more.
/// 152 distinct values are in use ("OPAPO", "GOT KOJOWI", "OSOGO KAJ"): cane
/// collection zones in a local naming system. They are deliberately NOT
/// geocoded — probing Nominatim on the fourteen busiest returned five matches,
/// three of them plainly wrong (a primary school 20 km away, a road 25 km
/// away), so any coordinate derived from the text would be a fabrication. What
/// CAN be measured is time: the dispatch clock is exact, and the fleet's own
/// completed trips to the same destination give a typical duration.
///
/// Why a table rather than living off the provider: `/dispatches` is capped at
/// 1000 rows with no pagination, so the history it exposes is a sliding window
/// that will eventually drop the trips the duration statistics are built from.
model Dispatch {
  id               String    @id @default(cuid())
  /// Provider's dispatch UUID — dedupe key across webhook, reconciler and backfill.
  externalId       String    @unique @map("external_id")
  organisationId   String    @map("organisation_id")
  /// Which lifecycle produced this row. See DispatchKind.
  ///
  /// The organisation is the UNIT'S OWNER, not the factory's operator — a
  /// Menengai truck collecting sugar at Naitiri belongs to MENENGAI here. See
  /// modules/webhooks/factory-map's `resolveEventOrg` for why.
  kind             DispatchKind @default(CANE)
  /// NULL when the plate does not resolve to our registry.
  vehicleId        String?   @map("vehicle_id")
  plate            String
  driverName       String    @map("driver_name")
  /// Free text, verbatim from the provider. Never parsed into coordinates.
  destination      String?
  /// The provider factory this run STARTED from (see webhooks/factory-map).
  ///
  /// The provider records a destination and never an origin, and until this
  /// column existed the origin was assumed to be the owning organisation's own
  /// yard. That assumption breaks exactly where the routing fix bites: a
  /// Menengai truck loading at Naitiri starts its run 250 km from Menengai's
  /// hub, so a trip measured from the hub would be measured from the wrong
  /// place and labelled with the wrong name.
  ///
  /// Also the only way to know WHAT a sales load is — the payload carries a
  /// tonnage and never says of what, and the commodity is a property of the
  /// site (Naitiri ships processed sugar). NULL for rows written before this
  /// column, and for any source that does not name a factory.
  factoryCode      String?   @map("factory_code")
  /// DISPATCHED | OVERDUE | COMPLETED | CANCELLED, as the provider reports it.
  status           String
  dispatchedAt     DateTime  @map("dispatched_at")
  /// The dispatcher's own commitment, when they set one — present on about a
  /// third of open dispatches. Beats any estimate we could compute.
  expectedReturnAt DateTime? @map("expected_return_at")
  actualReturnAt   DateTime? @map("actual_return_at")
  receivedAt       DateTime  @default(now()) @map("received_at")
  /// 'webhook' when pushed, 'reconciler' on the safety-net poll, 'backfill' from sync:dispatches.
  source           String    @default("webhook")

  // ── SALES only ────────────────────────────────────────────────────────────
  /// Load in tonnes, as the sales office recorded it. The ONLY weight the
  /// integration has ever carried: the provider sends none on a cane dispatch
  /// or a gate movement, Wialon's adapter hardcodes `cargoWeightKg: null`, and
  /// CargoManifest is written only by the simulator and the manual API. Bag
  /// counts are derived from this and nothing else.
  tonnageT         Float?    @map("tonnage_t")
  /// The guard's photo at sign-out / sign-in. Null on every row observed so
  /// far (2026-09-09) — the provider models the fields but is not populating
  /// them yet.
  signOutPhotoUrl  String?   @map("sign_out_photo_url")
  returnPhotoUrl   String?   @map("return_photo_url")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])

  // "what is open right now for this org" — the hot query behind the tooltip.
  @@index([organisationId, actualReturnAt, dispatchedAt])
  // The same question narrowed to one lifecycle. Without `kind` leading, a
  // sales query on a mostly-cane fleet scans the cane rows to discard them.
  @@index([organisationId, kind, dispatchedAt])
  @@index([vehicleId, dispatchedAt])
  // Duration statistics per destination, over completed trips only.
  @@index([organisationId, destination, actualReturnAt])
  @@map("dispatches")
}

/// Where a dispatch destination actually IS, measured from the fleet's own
/// completed trips.
///
/// The provider records the destination as free text and nothing else — 152
/// distinct cane-zone names ("OPAPO", "GOT KOJOWI"), no coordinates, and not
/// in any gazetteer worth trusting: probing Nominatim on the fourteen busiest
/// returned five matches, three plainly wrong. So this is derived instead of
/// looked up. For every COMPLETED dispatch, take the vehicle's fix farthest
/// from the hub between the dispatch and return clocks — the turn-around
/// point — and take the median of those across every trip to the same name.
///
/// It is a measurement, so it carries its own error bars and the reader is
/// expected to check them: `samples` is how many trips agreed and `spreadM` is
/// how far apart they were. A name used twice, or one whose trips scatter over
/// 5 km, is a zone rather than a point and must not be drawn as one.
///
/// Validated 2026-08-03 against an operator-supplied coordinate for NYAONDO:
/// 39 trips, 0.1 km spread, and the derived point sits 83 m from theirs.
model DispatchDestination {
  id               String   @id @default(cuid())
  organisationId   String   @map("organisation_id")
  /// UPPER(TRIM(dispatch.destination)) — the same key the duration statistics
  /// group on, because the dispatchers type it freehand and the casing wanders.
  name             String
  lat              Float
  lng              Float
  /// Completed trips this point was measured from.
  samples          Int
  /// Median distance from a trip's own turn-around to the consensus point.
  /// Small = a place; large = a spread-out zone with no single point.
  spreadM          Int      @map("spread_m")
  /// Straight-line hub → here, cached so the round-trip maths needs one row.
  distanceFromHubM Int      @map("distance_from_hub_m")
  computedAt       DateTime @default(now()) @map("computed_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, name])
  @@map("dispatch_destinations")
}

/// Durable Live Feed history — every item the operations feed has ever shown,
/// whatever produced it.
///
/// Distinct from ProviderAlert and VehicleAlert, which are SOURCE records: one
/// is what RaiFactorySuite told us, the other is what our telemetry flags
/// raised. This is the PRESENTATION record — the notification as the operator
/// saw it — and it is the only one of the three that also captures narration
/// with no source row at all (zone arrivals/departures, dispatch narration).
///
/// It exists because the feed was previously a 60-item in-memory ring buffer,
/// global across organisations and wiped by every restart. Nothing could read
/// notification history back, and nothing expired it.
///
/// Retention: swept by the BullMQ `notifications:prune` job after
/// NOTIFICATION_RETENTION_DAYS (see lib/queues/retention.ts).
model Notification {
  id             String   @id @default(cuid())
  /// The feed id its emitter minted (`pa-`, `wn-`, `dp-`, `mv-`, `zn-`,
  /// `feed-`). UNIQUE, so a webhook redelivery or a reconcile pass that
  /// re-surfaces the same alert updates one row instead of duplicating the
  /// feed — the same idempotency ProviderAlert.externalId gives the source.
  feedId         String   @unique @map("feed_id")
  organisationId String   @map("organisation_id")
  vehicleId      String?  @map("vehicle_id")
  /// Which pipeline produced it: controltech | wialon | telemetry | zone.
  source         String
  /// Emitter's own type string (TRACTOR_OVERDUE, MOVEMENT_EXIT, ZONE_ENTRY …).
  alertType      String?  @map("alert_type")
  /// info | success | warning | critical — matches the feed's `type` field.
  severity       String
  /// The wording shown in the feed, verbatim.
  text           String
  plate          String?
  /// When the event HAPPENED (provider/device time), not when we stored it.
  /// The retention sweep and the feed both order by this.
  occurredAt     DateTime @map("occurred_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])

  /// Serves the org-scoped history endpoint (newest first).
  @@index([organisationId, occurredAt])
  /// Serves the same endpoint filtered to ONE vehicle — the map's per-unit
  /// feed. Without it that read is the org range scan plus a filter, and one
  /// vehicle is a few hundredths of the rows, so it would walk most of the
  /// organisation's history to fill a page.
  @@index([organisationId, vehicleId, occurredAt])
  /// Serves the retention sweep, which scans by age ACROSS organisations.
  @@index([occurredAt])
  @@map("notifications")
}
