generator client {
  provider             = "prisma-client"
  output               = "../generated/prisma"
  // Without these, the generator emits extensionless relative imports
  // (e.g. `from './enums'`), which only resolves under a bundler/loader.
  // Plain `node dist/src/index.js` in production needs explicit .js
  // specifiers to resolve ESM imports — same convention already used
  // throughout src/.
  moduleFormat         = "esm"
  importFileExtension  = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum AssignmentType {
  PRIMARY // permanently assigned driver
  RELIEF  // temporary / cover assignment
}

enum PeriodType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum FuelEventType {
  FILLING
  THEFT
}

/// What happened to the fuel — a description of the event, never an accusation.
///
/// Wialon's report decides that a level drop is a theft; measured over the 250
/// most recent drains per org, 40% (KASULU) and 50% (SUKARI) of the DECIDABLE
/// volume came back with no filling to explain it — fuel that moved away from
/// the probe and returned, not fuel that left. So the provider's claim is
/// adjudicated against our own level series before it is reported as anything.
///
/// The values changed on 2026-08-11 at the operator's instruction: LOSS and
/// UNVERIFIED are gone. LOSS asserted where the fuel went, which telemetry
/// cannot see; UNVERIFIED described our EVIDENCE rather than the fuel, and
/// covered 1,938 of 2,571 rows, leaving the ledger unreadable. How sure we are
/// now lives in verdictReason and in `isConfirmed` beside the verdict, not
/// instead of it. See modules/fuel/fuel-adjudication.
enum FuelEventVerdict {
  PENDING        // too recent to judge — the level may still come back
  REFILL         // a filling explains it: fuel went IN, it did not leave
  DRAIN          // the level went down and did not come back
  REDISTRIBUTION // the level returned with no filling: undulation, it never left
  /// The fuel probe failed, not the tank. Not a fuel event at all, and never
  /// announced: blaming a driver for a dead sensor is the one outcome here
  /// that is worse than missing a real drain.
  SENSOR_FAULT
}

/// Shape of a geofence boundary.
enum GeofenceType {
  CIRCLE  // defined by centerLat + centerLng + radiusM
  POLYGON // defined by polygonCoords (GeoJSON ring)
  LINE    // corridor: polygonCoords is the centre-line, widthM its width
}

/// Controls whether the fence is an allowed zone or a forbidden zone.
enum FenceMode {
  ALLOWLIST // vehicle must stay INSIDE — alert on exit
  BLOCKLIST // vehicle must stay OUTSIDE — alert on entry
}

/// Structured cargo classification — prevents free-text inconsistency.
enum CargoType {
  BULK
  PACKAGED
  LIVESTOCK
  HAZMAT
  FUEL
  MACHINERY
  OTHER
}

/// Severity tier for live operational alerts in the Fleet Operations feed.
enum AlertSeverity {
  WARNING
  CRITICAL
}

// ---------------------------------------------------------------------------
// IAM — identity & access control
// ---------------------------------------------------------------------------

/// Top-level tenant. All entities are scoped to an organisation.
model Organisation {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  /// The yard/plant every dispatch leaves from and returns to, MEASURED from
  /// the fleet's own telemetry (the densest cell of fixes) rather than typed
  /// in — see prisma/sync-destinations.ts. NULL until that script has run.
  ///
  /// It is the origin of every round trip: the provider records a destination
  /// and nothing else, so "where did it set off from" has no other source.
  hubLat    Float?   @map("hub_lat")
  hubLng    Float?   @map("hub_lng")
  /// The GATE the fleet actually leaves through — the barrier/weigh-out, not
  /// the yard's centre. Distinct from the hub even when they are metres apart
  /// (SUKARI's are 17 m apart), because a departure is measured against the
  /// gate and "at the yard" is measured against the hub. Supplied by the
  /// operator, and re-derivable from telemetry: the gate is where outbound
  /// vehicles halt, which clusters far more tightly than anything else on the
  /// way out. NULL falls back to the hub radius — see lib/yard-departure.
  gateLat     Float? @map("gate_lat")
  gateLng     Float? @map("gate_lng")
  /// How far past the gate counts as through it. Sized from the measured halt
  /// spread (13-20 m at SUKARI), wide enough to contain the halt and narrow
  /// enough to stay clear of the next cluster inside the site.
  gateRadiusM Int?   @map("gate_radius_m")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles             Role[]
  users             User[]
  vehicleGroups     VehicleGroup[]
  vehicles          Vehicle[]
  reportingPeriods  ReportingPeriod[]
  routes            Route[]
  geofences         Geofence[]
  ingestApiKeys     IngestApiKey[]
  pushSubscriptions PushSubscription[]
  alerts            VehicleAlert[]
  silos             Silo[]
  providerAlerts    ProviderAlert[]
  notifications     Notification[]
  dispatches        Dispatch[]
  dispatchDestinations DispatchDestination[]

  @@map("organisations")
}

/// Named role scoped to an organisation (e.g. "fleet_manager", "driver", "mechanic").
model Role {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation     @relation(fields: [organisationId], references: [id])
  permissions  RolePermission[]
  userRoles    UserRole[]

  @@unique([organisationId, slug])
  @@index([organisationId])
  @@map("roles")
}

/// Atomic capability — resource + action (e.g. vehicle:read, trip:create).
model Permission {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  resource String // e.g. "vehicle", "trip", "fuel_theft"
  action   String // e.g. "read", "create", "update", "delete"

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

/// Many-to-many join: which permissions belong to which role.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// A person who can log in to the system and/or be assigned to a vehicle.
/// Drivers are Users who hold the "driver" Role.
model User {
  id             String     @id @default(cuid())
  organisationId String     @map("organisation_id")
  fullName       String     @map("full_name")
  // NULL for people synced from the RaiFactorySuite driver registry — the
  // provider holds no email addresses and drivers don't log in. Postgres
  // permits many NULLs under a unique index, so logins stay unaffected.
  email          String?    @unique
  phone          String?
  licenceNumber  String?    @map("licence_number")
  employeeId     String?    @map("employee_id")
  // RaiFactorySuite driver UUID — the stable upsert key for sync:drivers.
  externalId     String?    @unique @map("external_id")
  // Provider's DUTY state (ON_DUTY / OFF_DUTY / TERMINATED) — distinct from
  // `status`, which is employment standing in our own RBAC model.
  dutyStatus     String?    @map("duty_status")
  // Provider's driver class (TRACTOR / TRUCK / COMPANY_VEHICLE) — the vehicle
  // type this driver is licensed to operate.
  driverType     String?    @map("driver_type")
  status         UserStatus @default(ACTIVE)
  // bcrypt hash for local auth (scripts/set-password.ts sets it).
  // NULL = account cannot log in (all pre-2026-07 accounts start this way —
  // auth previously lived in Supabase and its user pool was never populated).
  passwordHash   String?    @map("password_hash")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at") // soft delete — preserves FK integrity on trips

  // Persisted driver rating (1.0–5.0, starts at 5.0). Overspeeding is scored
  // per-trip and updated here on trip completion (see simulation.persistence.ts)
  // so the score can self-heal on clean trips instead of being recomputed from
  // a rolling window every time. Only meaningful when the user holds the
  // "driver" role.
  driverRatingScore Float @default(5.0) @map("driver_rating_score")

  organisation Organisation @relation(fields: [organisationId], references: [id])

  // IAM
  userRoles UserRole[]

  // Driver-specific relations (only relevant when user holds "driver" role)
  vehicleAssignments VehicleAssignment[] @relation("AssignedUser")
  trips              Trip[]              @relation("TripDriver")
  fuelThefts         FuelTheft[]         @relation("TheftDriver")
  geofenceViolations GeofenceViolation[] @relation("ViolationDriver")

  // Audit — who assigned/unassigned
  assignmentsGranted   VehicleAssignment[] @relation("AssignedByUser")
  userRolesGranted     UserRole[]          @relation("UserRoleGrantedBy")
  geofencesAssigned    VehicleGeofence[]   @relation("GeofenceAssignedBy")
  ingestApiKeysCreated IngestApiKey[]      @relation("ApiKeyCreatedBy")

  // Notifications
  pushSubscriptions PushSubscription[]

  @@index([organisationId])
  @@index([email])
  @@index([organisationId, status])
  @@map("users")
}

/// Audit-tracked role grant. Soft-revoked via revokedAt rather than hard-deleted.
model UserRole {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  roleId       String    @map("role_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  revokedAt    DateTime? @map("revoked_at")
  assignedById String?   @map("assigned_by")

  user       User  @relation(fields: [userId], references: [id])
  role       Role  @relation(fields: [roleId], references: [id])
  assignedBy User? @relation("UserRoleGrantedBy", fields: [assignedById], references: [id])

  @@index([userId])
  @@index([roleId])
  @@index([userId, revokedAt]) // fast "active roles for user" query
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// DEVICE AUTH — ingest API keys (separate from user JWT auth)
// ---------------------------------------------------------------------------

/// Scoped API key that authorises a GPS/FLS device (or vendor platform) to
/// push telemetry to POST /api/v1/ingest/telemetry.
/// Store only the SHA-256 hash — never the raw key.
model IngestApiKey {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  label          String                           // human name e.g. "RaiFactorySuite Webhook"
  keyHash        String    @unique @map("key_hash") // SHA-256(rawKey) — raw key shown once at creation
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime? @map("expires_at")    // NULL = no expiry
  lastUsedAt     DateTime? @map("last_used_at")  // updated on every successful ingest
  createdById    String?   @map("created_by")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  createdBy    User?        @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  @@index([organisationId])
  @@index([keyHash])       // primary lookup on every ingest request
  @@map("ingest_api_keys")
}

// ---------------------------------------------------------------------------
// FLEET — master data
// ---------------------------------------------------------------------------

/// Logical grouping of vehicles (e.g. Harvesting, Ambulance, Sales).
model VehicleGroup {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  name           String
  code           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  vehicles     Vehicle[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("vehicle_groups")
}

/// A physical vehicle tracked by a GPS/FLS device.
model Vehicle {
  id                 String   @id @default(cuid())
  organisationId     String   @map("organisation_id")
  vehicleGroupId     String   @map("vehicle_group_id")
  name               String
  registrationPlate  String   @unique @map("registration_plate")
  // Telemetry ingest key. There is no on-prem GPS hardware — vehicles are
  // provisioned by the RaiFactorySuite API and polled per-vehicle, so this
  // holds the provider's vehicle UUID (same value as externalId).
  deviceId           String   @unique @map("device_id")
  // RaiFactorySuite vehicle UUID — the stable upsert key for sync:vehicles.
  externalId         String?  @unique @map("external_id")
  vehicleType        String   @map("vehicle_type")      // TRACTOR, TRUCK, COMPANY_VEHICLE, …
  // Registry status as reported by the provider (AVAILABLE / DISPATCHED /
  // DECOMMISSIONED). Operational status (moving, idling, …) comes from
  // telemetry, not this column.
  status             String?
  // False when the provider decommissions or drops the vehicle — kept as a row
  // for history (trips/alerts FK it) but excluded from the live fleet.
  isActive           Boolean  @default(true) @map("is_active")
  fuelEfficiencyKmpl Float?   @map("fuel_efficiency_kmpl")
  tankCapacityLitres Float?   @map("tank_capacity_litres")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  vehicleGroup VehicleGroup @relation(fields: [vehicleGroupId], references: [id])

  assignments        VehicleAssignment[]
  trips              Trip[]
  engineHourSessions EngineHourSession[]
  fuelFillings       FuelFilling[]
  fuelThefts         FuelTheft[]
  fuelDailyTrends    FuelDailyTrend[]
  periodSummaries    VehiclePeriodSummary[]
  serviceRecords     VehicleServiceRecord[]
  garageVisits       VehicleGarageVisit[]

  // Live telemetry relations
  telemetry          VehicleTelemetry[]
  geofences          VehicleGeofence[]
  geofenceViolations GeofenceViolation[]
  alerts             VehicleAlert[]
  providerAlerts     ProviderAlert[]
  notifications      Notification[]
  dispatches         Dispatch[]

  @@index([organisationId])
  @@index([vehicleGroupId])
  @@index([deviceId]) // critical — raw telemetry arrives keyed to deviceId
  @@map("vehicles")
}

/// Time-bounded record of which user (driver) is assigned to which vehicle.
/// Query current assignment: WHERE unassignedAt IS NULL AND vehicleId = ?
/// Query assignment on a date: WHERE assignedAt <= date AND (unassignedAt IS NULL OR unassignedAt > date)
model VehicleAssignment {
  id             String         @id @default(cuid())
  vehicleId      String         @map("vehicle_id")
  userId         String         @map("user_id")
  assignmentType AssignmentType @default(PRIMARY) @map("assignment_type")
  assignedAt     DateTime       @default(now()) @map("assigned_at")
  unassignedAt   DateTime?      @map("unassigned_at") // NULL = currently active
  assignedById   String?        @map("assigned_by")
  notes          String?

  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  user       User    @relation("AssignedUser", fields: [userId], references: [id])
  assignedBy User?   @relation("AssignedByUser", fields: [assignedById], references: [id])

  @@index([vehicleId, unassignedAt]) // "who is assigned to this vehicle right now?"
  @@index([userId, unassignedAt])    // "which vehicle is this driver assigned to?"
  @@index([vehicleId, assignedAt])   // time-range lookups for incident investigation
  @@map("vehicle_assignments")
}

// ---------------------------------------------------------------------------
// REPORTING
// ---------------------------------------------------------------------------

/// Named time window that groups all events (e.g. "Week 24", "June 2026").
model ReportingPeriod {
  id             String     @id @default(cuid())
  organisationId String     @map("organisation_id")
  label          String
  periodStart    DateTime   @map("period_start")
  periodEnd      DateTime   @map("period_end")
  periodType     PeriodType @map("period_type")

  organisation Organisation @relation(fields: [organisationId], references: [id])

  trips           Trip[]
  engineSessions  EngineHourSession[]
  fuelFillings    FuelFilling[]
  fuelThefts      FuelTheft[]
  periodSummaries VehiclePeriodSummary[]

  @@index([organisationId, periodStart])
  @@map("reporting_periods")
}

// ---------------------------------------------------------------------------
// ROUTES — named origin-destination paths with ordered waypoints
// ---------------------------------------------------------------------------

/// A pre-defined route between two named locations, optionally with intermediate waypoints.
/// Trips are linked to a route at dispatch time; ad-hoc trips leave routeId NULL.
model Route {
  id              String   @id @default(cuid())
  organisationId  String   @map("organisation_id")
  name            String                           // "Garissa Depot → Nairobi CBD Warehouse"
  originName      String   @map("origin_name")
  originLat       Float    @map("origin_lat")
  originLng       Float    @map("origin_lng")
  destinationName String   @map("destination_name")
  destinationLat  Float    @map("destination_lat")
  destinationLng  Float    @map("destination_lng")
  distanceKm      Float?   @map("distance_km")    // expected / approved distance
  isActive        Boolean  @default(true) @map("is_active") // retire without deleting
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organisation Organisation   @relation(fields: [organisationId], references: [id])
  waypoints    RouteWaypoint[]
  trips        Trip[]

  @@index([organisationId])
  @@index([organisationId, isActive]) // list active routes for an org
  @@map("routes")
}

/// Ordered checkpoint along a Route. Arrival is confirmed when a telemetry ping
/// falls within radiusM of the waypoint's coordinates.
model RouteWaypoint {
  id       String  @id @default(cuid())
  routeId  String  @map("route_id")
  sequence Int                      // 1-based ordering along the route
  name     String?                  // e.g. "Thika Bypass Interchange"
  lat      Float
  lng      Float
  radiusM  Int     @default(200) @map("radius_m") // arrival tolerance in metres

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence])       // enforce ordering uniqueness
  @@index([routeId, sequence])
  @@map("route_waypoints")
}

// ---------------------------------------------------------------------------
// GEOFENCING — spatial boundaries with violation tracking
// ---------------------------------------------------------------------------

/// A named spatial boundary applied to one or more vehicles.
model Geofence {
  id             String     @id @default(cuid())
  organisationId String     @map("organisation_id")
  name           String                          // "Nairobi CBD Delivery Zone"
  type           GeofenceType                    // CIRCLE | POLYGON | LINE
  mode           FenceMode  @default(ALLOWLIST) @map("mode") // ALLOWLIST | BLOCKLIST
  /// Provider's own zone id (e.g. "wialon:zone:14") — upsert key for syncs.
  externalId     String?    @unique @map("external_id")
  // Circle geometry
  centerLat      Float?     @map("center_lat")
  centerLng      Float?     @map("center_lng")
  radiusM        Int?       @map("radius_m")
  // Polygon geometry — GeoJSON LinearRing [[lng,lat],...] stored as Json.
  // Also holds a LINE fence's centre-line path, same [[lng,lat],…] ordering.
  polygonCoords  Json?      @map("polygon_coords")
  /// LINE (corridor) only: full width in metres. A vehicle is inside when it
  /// is within widthM/2 of the centre-line — how Wialon models haulage roads,
  /// drains and rivers.
  widthM         Float?     @map("width_m")
  /// DERIVED PostGIS shape — a CIRCLE's centre buffered by radiusM, a POLYGON's
  /// ring, a LINE's centre-line buffered by widthM/2. The columns above stay the
  /// source of truth; the `geofences_geom_sync` trigger keeps this in step with
  /// them, so nothing in the app ever writes it. Exists for set-based work the
  /// Json columns cannot do — validating rings, exact areas, and matching
  /// telemetry history against a boundary. Live containment is still evaluated
  /// in memory by lib/zone-presence.ts and does not read this.
  ///
  /// Prisma has no geography type: `Unsupported` means it is never returned by
  /// findMany/findFirst. Read it through $queryRaw.
  geom           Unsupported("geography(Geometry, 4326)")?
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organisation Organisation      @relation(fields: [organisationId], references: [id])
  vehicles     VehicleGeofence[]
  violations   GeofenceViolation[]

  @@index([organisationId])
  @@index([organisationId, isActive])
  @@map("geofences")
}

/// Join table scoping a Geofence to a specific Vehicle, with audit trail.
model VehicleGeofence {
  vehicleId   String   @map("vehicle_id")
  geofenceId  String   @map("geofence_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")
  assignedById String? @map("assigned_by")

  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  geofence   Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("GeofenceAssignedBy", fields: [assignedById], references: [id])

  @@id([vehicleId, geofenceId])
  @@index([geofenceId])
  @@map("vehicle_geofences")
}

/// Recorded instance of a vehicle crossing a geofence boundary unexpectedly.
/// Written asynchronously by the geofence-evaluation BullMQ worker — never on the ingest hot path.
model GeofenceViolation {
  id         String    @id @default(cuid())
  vehicleId  String    @map("vehicle_id")
  geofenceId String    @map("geofence_id")
  driverId   String?   @map("driver_id")
  occurredAt DateTime  @map("occurred_at")  // timestamp from the triggering telemetry ping
  resolvedAt DateTime? @map("resolved_at")  // when the vehicle returned / dispatcher acknowledged
  lat        Float
  lng        Float
  speedKmh   Float?    @map("speed_kmh")
  notifiedAt DateTime? @map("notified_at")  // when SSE / SMS alert was dispatched

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  geofence Geofence @relation(fields: [geofenceId], references: [id])
  driver   User?    @relation("ViolationDriver", fields: [driverId], references: [id])

  @@index([vehicleId, occurredAt])
  @@index([geofenceId, occurredAt])
  @@index([driverId, occurredAt])   // driver-centric violation reports
  @@index([occurredAt])             // org-wide violation timeline
  @@map("geofence_violations")
}

/// Live operational alert raised from a telemetry flag (overspeeding, fuel
/// theft, low fuel, etc). Stays open (resolvedAt = null) for as long as the
/// underlying condition is still active on each poll cycle — the poller
/// closes it the moment the flag clears. This is what makes a vehicle's
/// critical state survive a page reload instead of disappearing with the
/// transient SSE event that originally raised it.
model VehicleAlert {
  id             String        @id @default(cuid())
  organisationId String        @map("organisation_id")
  vehicleId      String        @map("vehicle_id")
  type           String        // AlertType: overspeeding, fuelInconsistency, lowFuel, …
  severity       AlertSeverity
  message        String
  lat            Float?
  lng            Float?
  speedKmh       Float?        @map("speed_kmh")
  fuelLevelMl    Int?          @map("fuel_level_ml")
  meta           Json?
  triggeredAt    DateTime      @map("triggered_at")
  resolvedAt     DateTime?     @map("resolved_at") // null = still active/critical

  organisation Organisation @relation(fields: [organisationId], references: [id])
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])

  @@index([organisationId, resolvedAt])
  @@index([vehicleId, type, resolvedAt])
  @@map("vehicle_alerts")
}

// ---------------------------------------------------------------------------
// STORAGE — sugar silos / warehouses (source of the "sugar in storage" KPI)
// ---------------------------------------------------------------------------

/// A physical sugar storage silo / warehouse operated by the organisation.
/// storedTonnes is the current stock; fill ratio drives the ok/warning/critical
/// status shown in the dashboard header. Updated by intake/dispatch operations
/// (seeded for the demo; a real deployment would mutate storedTonnes on
/// weighbridge intake and depot dispatch events).
model Silo {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  name           String                              // "Sukari HQ Silo 1"
  code           String                              // stable per-org identifier — "SILO-HQ-01"
  locationName   String   @map("location_name")      // "Sukari Industries, Kakamega"
  lat            Float
  lng            Float
  capacityTonnes Float    @map("capacity_tonnes")
  storedTonnes   Float    @map("stored_tonnes")
  sugarType      String   @map("sugar_type")         // RAW | PROCESSED
  status         String   @default("ok")             // ok | warning | critical
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("silos")
}

// ---------------------------------------------------------------------------
// EVENTS — high-volume transactional tables (partition by began_at in Postgres)
// ---------------------------------------------------------------------------

/// One recorded journey: a vehicle moving from A to B.
model Trip {
  id                      String    @id @default(cuid())
  vehicleId               String    @map("vehicle_id")
  driverId                String?   @map("driver_id")          // nullable — may be unassigned
  reportingPeriodId       String    @map("reporting_period_id")
  routeId                 String?   @map("route_id")           // NULL = ad-hoc / unplanned trip
  /// The completed dispatch this trip was measured from, when it came from one.
  /// UNIQUE, so the builder can be re-run over any window without duplicating —
  /// the same idempotency the fuel sync gets from matching. NULL for trips from
  /// any other source (the retired simulator's rows, the REST create endpoint).
  dispatchId              String?   @unique @map("dispatch_id")
  beganAt                 DateTime  @map("began_at")
  endedAt                 DateTime  @map("ended_at")
  initialLocation         String?   @map("initial_location")
  finalLocation           String?   @map("final_location")
  durationSeconds         Int       @map("duration_seconds")   // store as int, format in app
  mileageKm               Float     @map("mileage_km")
  avgSpeedKmh             Float?    @map("avg_speed_kmh")
  maxSpeedKmh             Float?    @map("max_speed_kmh")
  engineHoursSeconds      Int?      @map("engine_hours_seconds")
  consumedMl              Int?      @map("consumed_ml")        // millilitres as int — no float drift
  consumedByFlsMl         Int?      @map("consumed_by_fls_ml")
  ratesDeviationByFls     Float?    @map("rates_deviation_by_fls")
  avgConsumptionL100km    Float?    @map("avg_consumption_l100km")
  avgConsumptionByFls     Float?    @map("avg_consumption_by_fls")
  avgIdleConsumptionByFls Float?    @map("avg_idle_consumption_by_fls")
  avgMileagePerUnitFls    Float?    @map("avg_mileage_per_unit_fls")
  initialFuelLevelMl      Int?      @map("initial_fuel_level_ml")
  finalFuelLevelMl        Int?      @map("final_fuel_level_ml")
  maxFuelLevelMl          Int?      @map("max_fuel_level_ml")
  minFuelLevelMl          Int?      @map("min_fuel_level_ml")

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  driver          User?           @relation("TripDriver", fields: [driverId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  route           Route?          @relation(fields: [routeId], references: [id])
  cargoManifest   CargoManifest?

  @@index([vehicleId, beganAt])
  @@index([driverId, beganAt])
  @@index([reportingPeriodId])
  @@index([routeId])
  @@index([beganAt]) // partition key for future Postgres range partitioning
  @@map("trips")
}

/// Engine-on session: captures idle vs in-motion time, useful for machinery without trips.
model EngineHourSession {
  id                        String   @id @default(cuid())
  vehicleId                 String   @map("vehicle_id")
  reportingPeriodId         String   @map("reporting_period_id")
  beganAt                   DateTime @map("began_at")
  endedAt                   DateTime @map("ended_at")
  initialLocation           String?  @map("initial_location")
  finalLocation             String?  @map("final_location")
  engineHoursSeconds        Int      @map("engine_hours_seconds")
  initialEngineHoursSeconds Int?     @map("initial_engine_hours_seconds")
  finalEngineHoursSeconds   Int?     @map("final_engine_hours_seconds")
  totalTimeSeconds          Int      @map("total_time_seconds")
  offTimeSeconds            Int?     @map("off_time_seconds")
  inMotionSeconds           Int?     @map("in_motion_seconds")
  idlingSeconds             Int?     @map("idling_seconds")
  mileageKm                 Float?   @map("mileage_km")
  avgSpeedKmh               Float?   @map("avg_speed_kmh")
  maxSpeedKmh               Float?   @map("max_speed_kmh")
  consumedMl                Int?     @map("consumed_ml")
  consumedByFlsMl           Int?     @map("consumed_by_fls_ml")
  consumedFlsMotionMl       Int?     @map("consumed_fls_motion_ml")
  consumedFlsIdleMl         Int?     @map("consumed_fls_idle_ml")
  avgConsumptionByFls       Float?   @map("avg_consumption_by_fls")
  avgConsumptionFlsMotion   Float?   @map("avg_consumption_fls_motion")
  avgConsumptionFlsIdle     Float?   @map("avg_consumption_fls_idle")
  avgConsumptionFlsTrips    Float?   @map("avg_consumption_fls_trips")
  initialFuelLevelMl        Int?     @map("initial_fuel_level_ml")
  finalFuelLevelMl          Int?     @map("final_fuel_level_ml")
  maxFuelLevelMl            Int?     @map("max_fuel_level_ml")
  minFuelLevelMl            Int?     @map("min_fuel_level_ml")

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  @@index([vehicleId, beganAt])
  @@index([reportingPeriodId])
  @@index([beganAt])
  @@map("engine_hour_sessions")
}

/// A completed scheduled service — one row per real MAINTENANCE-phase
/// completion in the simulator (see raifactorysuite.simulator.ts's `eventServiceCompleted`).
/// This is the durable record the Maintenance page's per-vehicle service
/// history report reads from; nothing here is derived/fabricated at read time.
model VehicleServiceRecord {
  id                   String   @id @default(cuid())
  vehicleId            String   @map("vehicle_id")
  servicedAt           DateTime @map("serviced_at")
  odometerKm           Float    @map("odometer_km")
  previousServiceOdoKm Float?   @map("previous_service_odo_km") // null for a vehicle's first recorded service
  nextServiceOdoKm     Float    @map("next_service_odo_km")
  createdAt            DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, servicedAt])
  @@map("vehicle_service_records")
}

/// A vehicle redirected to a third-party garage because its service came due
/// while out on the road (see the simulator's TO_GARAGE/AT_GARAGE phases).
/// Distinct from VehicleServiceRecord: this tracks the actual garage visit
/// (where, when in, when out, what was worked on), not just the odometer
/// cycle bookkeeping.
model VehicleGarageVisit {
  id            String   @id @default(cuid())
  vehicleId     String   @map("vehicle_id")
  garageName    String   @map("garage_name")
  garageLat     Float    @map("garage_lat")
  garageLng     Float    @map("garage_lng")
  enteredAt     DateTime @map("entered_at")
  exitedAt      DateTime @map("exited_at")
  durationMinutes Int    @map("duration_minutes")
  odometerKm    Float    @map("odometer_km")
  severityScore Float    @map("severity_score")   // 0–1
  itemsFixed    Json     @map("items_fixed")       // [{ name, replaced }, ...]
  createdAt     DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, enteredAt])
  @@map("vehicle_garage_visits")
}

/// A single refuelling event.
/// One vehicle's fuel day, kept so slosh can be TRENDED rather than recomputed.
///
/// Asked for by the operator: the fluctuation a moving tank shows is mostly
/// slosh artefact, and it wants a moving average maintained "not for theft
/// detection but for trend logging".
///
/// NOTHING in modules/fuel/fuel-adjudication reads this table and nothing
/// should. The drain rules have their own probe instrument, measured while
/// PARKED (getProbeProfile). A motion-slosh average feeding a theft verdict
/// would let a machine excuse its own drains by working rough ground.
model FuelDailyTrend {
  id            String   @id @default(cuid())
  vehicleId     String   @map("vehicle_id")
  /// The FLEET day this describes (Kenyan, not UTC — see lib/provider-time).
  day           DateTime @db.Date
  /// Closing level of the previous day; equals that day's closingMl.
  openingMl     Int?     @map("opening_ml")
  closingMl     Int?     @map("closing_ml")
  /// opening − closing. Not "burned" on a day carrying a refuel.
  consumedMl    Int?     @map("consumed_ml")
  /// Moving average of per-RUN slosh while in motion, over the last
  /// TURBULENCE_STOPS runs WHEREVER THEY FELL — the window crosses midnight.
  /// Slosh, not fuel moved. Formula at stopTurbulence in fuel-tank-state.
  turbulenceMl  Int?     @map("turbulence_ml")
  /// This day's individual run slosh values, in order, one per run.
  ///
  /// Kept because a moving average that spans days needs the runs themselves —
  /// a day's mean cannot be un-meaned. Most days hold one or two.
  runSloshMl    Int[]    @map("run_slosh_ml")
  /// STOPS the moving average spans, so a one-run figure is not read as
  /// confidently as an eight-run one. See stopTurbulence for the formula.
  stopsAveraged Int      @default(0) @map("stops_averaged")
  computedAt    DateTime @map("computed_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, day])
  @@index([vehicleId, day(sort: Desc)])
  @@index([day])
  @@map("fuel_daily_trends")
}

model FuelFilling {
  id                 String   @id @default(cuid())
  vehicleId          String   @map("vehicle_id")
  reportingPeriodId  String   @map("reporting_period_id")
  filledAt           DateTime @map("filled_at")
  location           String?
  mileageAtFillKm    Float?   @map("mileage_at_fill_km")
  initialFuelLevelMl Int?     @map("initial_fuel_level_ml")
  filledMl           Int      @map("filled_ml")
  finalFuelLevelMl   Int?     @map("final_fuel_level_ml")

  /// Our verdict on the provider's claim that this was a refuelling — see
  /// FuelEventVerdict and modules/fuel/fuel-filling-adjudication. Rows stay on
  /// the ledger whatever the verdict, so the rule can always be audited back.
  verdict        FuelEventVerdict @default(PENDING)
  verdictAt      DateTime?        @map("verdict_at")
  verdictReason  String?          @map("verdict_reason")
  /// Millilitres our OWN telemetry saw arrive. `filledMl` is left exactly as
  /// the provider reported it, so the two can always be compared; on 210 rows
  /// this is zero or negative against a positive claim.
  observedRiseMl Int?             @map("observed_rise_ml")

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  @@index([vehicleId, filledAt])
  @@index([reportingPeriodId])
  @@index([filledAt])
  /// Drives the adjudication sweep.
  @@index([verdict, filledAt])
  @@map("fuel_fillings")
}

/// A detected anomalous fuel-level drop (suspected theft or siphoning).
model FuelTheft {
  id                 String   @id @default(cuid())
  vehicleId          String   @map("vehicle_id")
  driverId           String?  @map("driver_id")          // nullable — vehicle may be unattended
  reportingPeriodId  String   @map("reporting_period_id")
  beganAt            DateTime @map("began_at")
  detectedAt         DateTime @map("detected_at")
  initialLocation    String?  @map("initial_location")
  initialFuelLevelMl Int?     @map("initial_fuel_level_ml")
  finalFuelLevelMl   Int?     @map("final_fuel_level_ml")
  stolenMl           Int      @map("stolen_ml")
  initialSpeedKmh    Float?   @map("initial_speed_kmh")  // 0 = stationary drain
  finalSpeedKmh      Float?   @map("final_speed_kmh")

  /// Our verdict on the provider's claim — see FuelEventVerdict and
  /// modules/fuel/fuel-adjudication. Rows stay on the ledger whatever the
  /// verdict, so the rule can always be audited back against Wialon.
  verdict       FuelEventVerdict @default(PENDING)
  verdictAt     DateTime?        @map("verdict_at")
  /// Millilitres of the observed drop that came back, from our own telemetry.
  recoveredMl   Int?            @map("recovered_ml")
  /// Short slug naming which rule decided it, for auditing.
  verdictReason String?         @map("verdict_reason")

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  driver          User?           @relation("TheftDriver", fields: [driverId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  @@index([vehicleId, beganAt])
  @@index([reportingPeriodId])
  @@index([beganAt])
  /// Drives the adjudication sweep: "which drains are still PENDING and old
  /// enough to judge?"
  @@index([verdict, detectedAt])
  @@map("fuel_thefts")
}

// ---------------------------------------------------------------------------
// LIVE TELEMETRY — high-frequency device pings
// ---------------------------------------------------------------------------

/// One positional/state snapshot pushed by the GPS/FLS device.
///
/// Performance design decisions:
///   • BigInt autoincrement PK — sequential inserts pack the B-tree efficiently;
///     CUID would scatter and fragment the index at millions of rows/day.
///   • @@unique([deviceId, capturedAt]) — idempotent ingest; vendor platform
///     retries never create duplicate rows.
///   • driverId denormalised — avoids a point-in-time join through VehicleAssignment
///     on every telemetry read. Resolved once at ingest time.
///   • rawPayload NOT stored here — moved to VehicleTelemetryRaw (separate table)
///     to keep this hot table narrow and cache-friendly.
///   • Geofence evaluation is NEVER run on this insert path; it is enqueued as a
///     BullMQ job and processed asynchronously by the geofence worker.
model VehicleTelemetry {
  id         BigInt   @id @default(autoincrement())
  vehicleId  String   @map("vehicle_id")
  deviceId   String   @map("device_id")   // denormalised — no join needed on ingest
  driverId   String?  @map("driver_id")   // denormalised — active driver at ping time
  capturedAt DateTime @map("captured_at") // device timestamp (NOT server receipt time)
  receivedAt DateTime @default(now()) @map("received_at")

  // Position
  lat        Float?
  lng        Float?
  altitudeM  Float?  @map("altitude_m")
  headingDeg Float?  @map("heading_deg")  // 0-360 compass bearing
  accuracyM  Float?  @map("accuracy_m")   // GPS horizontal accuracy in metres

  // Motion & engine
  speedKmh   Float?  @map("speed_kmh")    // instantaneous GPS speed
  engineOn   Boolean @default(false) @map("engine_on") // digital I/O pin state

  // Fuel (FLS sensor reading)
  fuelLevelMl Int?   @map("fuel_level_ml") // calibrated tank level in millilitres
  fuelUsedMl  Int?   @map("fuel_used_ml")  // delta vs. previous ping (negative = impossible → flag)

  // Cargo weight (load-cell sensor — NULL if vehicle not fitted)
  cargoWeightKg Float? @map("cargo_weight_kg")

  vehicle Vehicle  @relation(fields: [vehicleId], references: [id])

  @@unique([deviceId, capturedAt])    // idempotent ingest
  @@index([vehicleId, capturedAt])    // timeline + latest-ping (B-tree serves ASC and DESC)
  // A THIRD index exists on this table that is NOT declared here:
  //   vehicle_telemetries_moving_idx (vehicle_id, captured_at DESC)
  //     WHERE speed_kmh > 0
  // Prisma's schema language cannot express a partial index, so it lives in
  // migrations/20260801000000_telemetry_moving_partial_index. Do not "tidy it
  // up" as drift — without it the fleet snapshot's last-moved lookup scans the
  // full history of every vehicle that has never moved, and the query times
  // out. Details and measurements in that migration's header.
  @@index([capturedAt])               // partition key — range queries across all vehicles
  @@map("vehicle_telemetries")
}

/// Raw vendor payload stored separately so VehicleTelemetry stays narrow.
/// Only join this table for debugging, reprocessing, or vendor audit.
/// Linked 1-to-1 via the same BigInt id as VehicleTelemetry.
model VehicleTelemetryRaw {
  telemetryId BigInt @id @map("telemetry_id") // FK = VehicleTelemetry.id (no Prisma relation — avoid eager load)
  payload     Json                            // original vendor JSON/parsed binary packet

  @@map("vehicle_telemetry_raws")
}

// ---------------------------------------------------------------------------
// CARGO — manifest attached to a trip
// ---------------------------------------------------------------------------

/// Cargo declaration and load-sensor readings for a single trip.
/// declaredWeightKg comes from the waybill (manual entry at dispatch).
/// departureWeightKg / arrivalWeightKg come from load-cell sensor readings
/// pushed in VehicleTelemetry.cargoWeightKg at trip start and end.
model CargoManifest {
  id                 String    @id @default(cuid())
  tripId             String    @unique @map("trip_id") // one manifest per trip
  description        String?                           // free-text e.g. "Maize flour 50 kg bags"
  cargoType          CargoType? @map("cargo_type")     // enum — prevents "bulk" vs "BULK" drift
  declaredWeightKg   Float?    @map("declared_weight_kg")  // from waybill
  departureWeightKg  Float?    @map("departure_weight_kg") // sensor reading at trip start
  arrivalWeightKg    Float?    @map("arrival_weight_kg")   // sensor reading at trip end
  weightVarianceKg   Float?    @map("weight_variance_kg")  // computed: departure - arrival
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id])

  // No explicit @@index([tripId]) — @unique already creates an implicit B-tree index
  @@map("cargo_manifests")
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS — Web Push subscriptions
// ---------------------------------------------------------------------------

/// Browser Web Push subscription registered by a dashboard user.
/// Keyed by endpoint (unique per browser × origin). Stale subscriptions
/// (HTTP 410/404 from the push service) are automatically cleaned up.
model PushSubscription {
  id             String    @id @default(cuid())
  organisationId String?   @map("organisation_id")
  userId         String?   @map("user_id")
  endpoint       String    @unique        // push service URL — the natural key
  p256dh         String    @map("p256dh") // ECDH public key (base64url)
  auth           String                   // HMAC auth secret (base64url)
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [organisationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// SUMMARY — materialised roll-up (refresh periodically, not source of truth)
// ---------------------------------------------------------------------------

/// Pre-aggregated KPIs per vehicle per reporting period.
/// Powers dashboards without scanning all event tables.
model VehiclePeriodSummary {
  id                   String   @id @default(cuid())
  vehicleId            String   @map("vehicle_id")
  reportingPeriodId    String   @map("reporting_period_id")
  mileageInTripsKm     Float?   @map("mileage_in_trips_km")
  mileageAllMessagesKm Float?   @map("mileage_all_messages_km")
  avgSpeedKmh          Float?   @map("avg_speed_kmh")
  maxSpeedKmh          Float?   @map("max_speed_kmh")
  timeInTripsSeconds   Int?     @map("time_in_trips_seconds")
  engineHoursSeconds   Int?     @map("engine_hours_seconds")
  consumedByFlsMl      Int?     @map("consumed_by_fls_ml")
  avgConsumptionByFls  Float?   @map("avg_consumption_by_fls")
  avgMileagePerUnitFls Float?   @map("avg_mileage_per_unit_fls")
  initialFuelLevelMl   Int?     @map("initial_fuel_level_ml")
  finalFuelLevelMl     Int?     @map("final_fuel_level_ml")
  totalFilledMl        Int?     @map("total_filled_ml")
  totalStolenMl        Int?     @map("total_stolen_ml")
  refreshedAt          DateTime @default(now()) @map("refreshed_at")

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  @@unique([vehicleId, reportingPeriodId])
  @@index([reportingPeriodId])
  @@map("vehicle_period_summaries")
}

// ---------------------------------------------------------------------------
// SIMULATION — persisted state for the RaiFactorySuite mock so the simulation can
// pause on server stop and resume exactly where it left off on restart.
// ---------------------------------------------------------------------------

/// One row per simulated device holding the full VehicleSimState as JSON.
/// Written each poll cycle by RaiFactorySuiteMockAdapter and read on boot to
/// hydrate the in-memory simulator. Not part of the domain model — purely an
/// implementation detail of the mock telemetry provider.
model SimulationState {
  deviceId  String   @id @map("device_id")
  orgId     String?  @map("organisation_id")
  state     Json                            // serialised VehicleSimState
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("simulation_states")
}

/// Single-row (id = "singleton") heartbeat used to detect how long the
/// simulation was paused between a stop and the next start.
model SimulationMeta {
  id         String   @id @default("singleton")
  lastTickAt DateTime @map("last_tick_at")
  simDayKey  String?  @map("sim_day_key")
  simClockMs BigInt?  @map("sim_clock_ms")   // simulated-time epoch ms (6× real; paused across downtime)

  @@map("simulation_meta")
}

/// Operational alert raised by the RaiFactorySuite platform (dispatch/driver
/// governance: overdue tractors, driver swaps, blocked drivers, HOTO
/// discrepancies). Distinct from VehicleAlert, which is derived from OUR
/// telemetry flags and requires a vehicle: a provider alert is delivered
/// pre-composed, may concern people rather than a vehicle, and is keyed by the
/// provider's own id so a webhook redelivery is idempotent.
model ProviderAlert {
  id             String    @id @default(cuid())
  /// RaiFactorySuite alert UUID — dedupe key for webhook retries + backfill.
  externalId     String    @unique @map("external_id")
  organisationId String    @map("organisation_id")
  /// Vehicle named in the alert, when its plate resolves to our registry.
  vehicleId      String?   @map("vehicle_id")
  type           String    // TRACTOR_OVERDUE, DRIVER_BLOCKED, …
  severity       String    // info | warning | critical — mapped from `type`
  message        String
  /// Provider-side id of the related record (dispatch, driver, …).
  relatedId      String?   @map("related_id")
  plate          String?   // plate parsed out of the message, if any
  acknowledged   Boolean   @default(false)
  createdAt      DateTime  @map("created_at")     // provider's timestamp
  receivedAt     DateTime  @default(now()) @map("received_at")
  /// 'webhook' when pushed to us, 'backfill' when pulled by sync:alerts.
  source         String    @default("webhook")
  raw            Json?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])

  @@index([organisationId, createdAt])
  @@index([vehicleId, createdAt])
  @@map("provider_alerts")
}

/// A dispatch as RaiFactorySuite recorded it: this vehicle, this driver, sent
/// to this destination at this time.
///
/// The provider is the ONLY source of "where is it going" — it exposes no
/// coordinates, so `destination` is the dispatcher's free text and nothing more.
/// 152 distinct values are in use ("OPAPO", "GOT KOJOWI", "OSOGO KAJ"): cane
/// collection zones in a local naming system. They are deliberately NOT
/// geocoded — probing Nominatim on the fourteen busiest returned five matches,
/// three of them plainly wrong (a primary school 20 km away, a road 25 km
/// away), so any coordinate derived from the text would be a fabrication. What
/// CAN be measured is time: the dispatch clock is exact, and the fleet's own
/// completed trips to the same destination give a typical duration.
///
/// Why a table rather than living off the provider: `/dispatches` is capped at
/// 1000 rows with no pagination, so the history it exposes is a sliding window
/// that will eventually drop the trips the duration statistics are built from.
model Dispatch {
  id             String    @id @default(cuid())
  /// Provider's dispatch UUID — dedupe key across webhook, reconciler and backfill.
  externalId     String    @unique @map("external_id")
  organisationId String    @map("organisation_id")
  /// NULL when the plate does not resolve to our registry.
  vehicleId      String?   @map("vehicle_id")
  plate          String
  driverName     String    @map("driver_name")
  /// Free text, verbatim from the provider. Never parsed into coordinates.
  destination    String?
  /// DISPATCHED | OVERDUE | COMPLETED | CANCELLED, as the provider reports it.
  status         String
  dispatchedAt   DateTime  @map("dispatched_at")
  /// The dispatcher's own commitment, when they set one — present on about a
  /// third of open dispatches. Beats any estimate we could compute.
  expectedReturnAt DateTime? @map("expected_return_at")
  actualReturnAt   DateTime? @map("actual_return_at")
  receivedAt     DateTime  @default(now()) @map("received_at")
  /// 'webhook' when pushed, 'reconciler' on the safety-net poll, 'backfill' from sync:dispatches.
  source         String    @default("webhook")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])

  // "what is open right now for this org" — the hot query behind the tooltip.
  @@index([organisationId, actualReturnAt, dispatchedAt])
  @@index([vehicleId, dispatchedAt])
  // Duration statistics per destination, over completed trips only.
  @@index([organisationId, destination, actualReturnAt])
  @@map("dispatches")
}

/// Where a dispatch destination actually IS, measured from the fleet's own
/// completed trips.
///
/// The provider records the destination as free text and nothing else — 152
/// distinct cane-zone names ("OPAPO", "GOT KOJOWI"), no coordinates, and not
/// in any gazetteer worth trusting: probing Nominatim on the fourteen busiest
/// returned five matches, three plainly wrong. So this is derived instead of
/// looked up. For every COMPLETED dispatch, take the vehicle's fix farthest
/// from the hub between the dispatch and return clocks — the turn-around
/// point — and take the median of those across every trip to the same name.
///
/// It is a measurement, so it carries its own error bars and the reader is
/// expected to check them: `samples` is how many trips agreed and `spreadM` is
/// how far apart they were. A name used twice, or one whose trips scatter over
/// 5 km, is a zone rather than a point and must not be drawn as one.
///
/// Validated 2026-08-03 against an operator-supplied coordinate for NYAONDO:
/// 39 trips, 0.1 km spread, and the derived point sits 83 m from theirs.
model DispatchDestination {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  /// UPPER(TRIM(dispatch.destination)) — the same key the duration statistics
  /// group on, because the dispatchers type it freehand and the casing wanders.
  name           String
  lat            Float
  lng            Float
  /// Completed trips this point was measured from.
  samples        Int
  /// Median distance from a trip's own turn-around to the consensus point.
  /// Small = a place; large = a spread-out zone with no single point.
  spreadM        Int      @map("spread_m")
  /// Straight-line hub → here, cached so the round-trip maths needs one row.
  distanceFromHubM Int    @map("distance_from_hub_m")
  computedAt     DateTime @default(now()) @map("computed_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, name])
  @@map("dispatch_destinations")
}

/// Durable Live Feed history — every item the operations feed has ever shown,
/// whatever produced it.
///
/// Distinct from ProviderAlert and VehicleAlert, which are SOURCE records: one
/// is what RaiFactorySuite told us, the other is what our telemetry flags
/// raised. This is the PRESENTATION record — the notification as the operator
/// saw it — and it is the only one of the three that also captures narration
/// with no source row at all (zone arrivals/departures, dispatch narration).
///
/// It exists because the feed was previously a 60-item in-memory ring buffer,
/// global across organisations and wiped by every restart. Nothing could read
/// notification history back, and nothing expired it.
///
/// Retention: swept by the BullMQ `notifications:prune` job after
/// NOTIFICATION_RETENTION_DAYS (see lib/queues/retention.ts).
model Notification {
  id             String   @id @default(cuid())
  /// The feed id its emitter minted (`pa-`, `wn-`, `dp-`, `mv-`, `zn-`,
  /// `feed-`). UNIQUE, so a webhook redelivery or a reconcile pass that
  /// re-surfaces the same alert updates one row instead of duplicating the
  /// feed — the same idempotency ProviderAlert.externalId gives the source.
  feedId         String   @unique @map("feed_id")
  organisationId String   @map("organisation_id")
  vehicleId      String?  @map("vehicle_id")
  /// Which pipeline produced it: controltech | wialon | telemetry | zone.
  source         String
  /// Emitter's own type string (TRACTOR_OVERDUE, MOVEMENT_EXIT, ZONE_ENTRY …).
  alertType      String?  @map("alert_type")
  /// info | success | warning | critical — matches the feed's `type` field.
  severity       String
  /// The wording shown in the feed, verbatim.
  text           String
  plate          String?
  /// When the event HAPPENED (provider/device time), not when we stored it.
  /// The retention sweep and the feed both order by this.
  occurredAt     DateTime @map("occurred_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])

  /// Serves the org-scoped history endpoint (newest first).
  @@index([organisationId, occurredAt])
  /// Serves the same endpoint filtered to ONE vehicle — the map's per-unit
  /// feed. Without it that read is the org range scan plus a filter, and one
  /// vehicle is a few hundredths of the rows, so it would walk most of the
  /// organisation's history to fill a page.
  @@index([organisationId, vehicleId, occurredAt])
  /// Serves the retention sweep, which scans by age ACROSS organisations.
  @@index([occurredAt])
  @@map("notifications")
}
