INGEST_RATE_LIMIT_MAX=500

OPENWEATHER_API_KEY=23d5494aa65a0e789c3c414b1e9daba4

OPENAI_API_KEY=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

# RaiFactorySuite (factorysuite) — live vehicle/driver/alert provider.
# The CONTROLTECH_* names still work as fallbacks, so the deployed box can be
# migrated at its own pace.
RAIFACTORYSUITE_API_URL=https://factorysuite.org/api/external/v1
RAIFACTORYSUITE_API_KEY=rai_live_x4wQTBwjqIbEEF4Etdd_qTo4IBO8rwSREAnzLfyeM1Y

# Reconcile-poller cadence (ms) and kill switch. This loop is the safety net
# for webhook deliveries their sender gives up on — minutes, not seconds.
RAIFACTORYSUITE_POLL_MS=300000
# false in this local-dev template for the same reason POLL_ENABLED is: the
# deployed instance already reconciles the shared DB, and a second loop just
# doubles the traffic against the provider's API. Set true on the box.
RAIFACTORYSUITE_POLL_ENABLED=false

# Shared signing secret for the inbound RaiFactorySuite alert webhook (POST /webhook/rai).
FACTORY_SUITE_HOOK=WBk-K-d0r0hYMxiCgIrivsyygeoZtihwwHtc7sYOBjU

# Wialon Hosting — GPS provider for KASULU (Tanzania)
WIALON_API_URL=https://hst-api.wialon.com
WIALON_TOKEN=122a308a13d4a4ff9307804ea69f4ae640461C410666D9D17F1F08DC3163100F616D1E8C

# Telemetry poll cadence (ms). 2s drives the avl_evts delta loop.
POLL_INTERVAL_MS=2000

# Fuel fillings and drains from Wialon's own reports onto the Live Feed.
# Needs REDIS_URL (the job is a BullMQ repeatable) and MUST run in-process:
# the notification read path serves its first page from the Redis cache, which
# an external CLI cannot write — see lib/queues/fuel-events.ts.
# Set 'false' on additional instances so only ONE runs it.
FUEL_SYNC_ENABLED=true
# Every 15 min. A cycle only executes Wialon reports for vehicles whose own
# fuel readings moved, so a quiet cycle costs nothing.
FUEL_SYNC_CRON=*/15 * * * *

# The settle pass. Each cycle re-reads a rotating slice of vehicles over a
# window that has finished maturing and makes the ledger MATCH the provider for
# it — deleting events Wialon has since retracted, and reaching vehicles whose
# telemetry is too sparse to ever trigger the movement check.
#
# Turn this off only while a manual `sync:fuel --reconcile` is running: both
# reconcile the same 6h-back window and would race. Turn it straight back on —
# without it the ledger only ever grows, which is what let one drain be counted
# as ten. See docs/fuel-ledger-fidelity.md.
FUEL_SETTLE_ENABLED=true
# Vehicles per cycle. ~460 instrumented vehicles come round in under six hours
# at 20, for about a minute of extra Wialon time per cycle. 0 disables the pass.
FUEL_SETTLE_BATCH=20
