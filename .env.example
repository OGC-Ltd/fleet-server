NODE_ENV=development
PORT=3000
AUTH_BYPASS=true

# API-only: the remote deployment already runs the telemetry sim on this DB —
# a second concurrent sim writes conflicting positions and duplicate trips.
POLL_ENABLED=false

JWT_SECRET=52121cf2eb975900429233dc669d1c6f0bd421fea09ebc48cad85cd896b7f84e

# LOCAL DEVELOPMENT database — the private RDS reached through an SSH tunnel.
# `npm run dev` loads this file (DOTENV_CONFIG_PATH=.env.example).
# Start the tunnel first if it isn't running:
#   ssh -i "C:\Users\supervisor\Documents\keys\logistics.pem" -N -L 15432:fleet-store.c8ty8uocsdjp.us-east-1.rds.amazonaws.com:5432 ubuntu@ec2-32-198-44-105.compute-1.amazonaws.com   
DATABASE_URL="postgresql://fleet_app:4509829b1ab646b513dd83bbb9b511b0aff3c4ae5166d751@localhost:15432/fleet?uselibpqcompat=true&sslmode=require"
DIRECT_URL="postgresql://fleet_app:4509829b1ab646b513dd83bbb9b511b0aff3c4ae5166d751@localhost:15432/fleet?uselibpqcompat=true&sslmode=require"

CORS_ORIGIN=*
