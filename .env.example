# a second concurrent sim writes conflicting positions and duplicate trips.
POLL_ENABLED=false

JWT_SECRET=52121cf2eb975900429233dc669d1c6f0bd421fea09ebc48cad85cd896b7f84e

# LOCAL DEVELOPMENT database — the private RDS reached through an SSH tunnel.
