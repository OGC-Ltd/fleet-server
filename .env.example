# TEMPLATE ONLY — placeholders, never real values. This file is committed and
# the repository is public. Copy it to `.env` (git-ignored) and fill that in:
#   cp .env.example .env
NODE_ENV=development
PORT=3000
AUTH_BYPASS=false

# API-only: the remote deployment already runs the telemetry sim on this DB —
# a second concurrent sim writes conflicting positions and duplicate trips.
POLL_ENABLED=false

JWT_SECRET=replace-with-at-least-32-random-chars   # openssl rand -hex 32

# LOCAL DEVELOPMENT database — the private RDS reached through an SSH tunnel.
# Copy this file to .env (untracked) and fill in real values; `npm run dev` loads .env.
# Start the tunnel first if it isn't running:
#   ssh -i <path-to-key.pem> -N -L 15432:<rds-endpoint>:5432 ubuntu@<bastion-host>   (see guide.md)
DATABASE_URL="postgresql://fleet_app:<password>@localhost:15432/fleet?uselibpqcompat=true&sslmode=require"
DIRECT_URL="postgresql://fleet_app:<password>@localhost:15432/fleet?uselibpqcompat=true&sslmode=require"

CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
INGEST_RATE_LIMIT_MAX=500

OPENWEATHER_API_KEY=

OPENAI_API_KEY=

# RaiFactorySuite (factorysuite) — live vehicle/driver/alert provider.
# The CONTROLTECH_* names still work as fallbacks, so the deployed box can be
# migrated at its own pace.
RAIFACTORYSUITE_API_URL=https://factorysuite.org/api/external/v1
RAIFACTORYSUITE_API_KEY=

# Reconcile-poller cadence (ms) and kill switch. This loop is the safety net
# for webhook deliveries their sender gives up on — minutes, not seconds.
RAIFACTORYSUITE_POLL_MS=300000
# false in this local-dev template for the same reason POLL_ENABLED is: the
# deployed instance already reconciles the shared DB, and a second loop just
# doubles the traffic against the provider's API. Set true on the box.
RAIFACTORYSUITE_POLL_ENABLED=false

# Shared signing secret for the inbound RaiFactorySuite alert webhook (POST /webhook/rai).
FACTORY_SUITE_HOOK=

# Wialon Hosting — GPS provider for KASULU (Tanzania)
WIALON_API_URL=https://hst-api.wialon.com
WIALON_TOKEN=

# Telemetry poll cadence (ms). 2s drives the avl_evts delta loop.
POLL_INTERVAL_MS=2000

# Fuel fillings and drains from Wialon's own reports onto the Live Feed.
# Needs REDIS_URL (the job is a BullMQ repeatable) and MUST run in-process:
# the notification read path serves its first page from the Redis cache, which
# an external CLI cannot write — see lib/queues/fuel-events.ts.
# Set 'false' on additional instances so only ONE runs it.
FUEL_SYNC_ENABLED=true
# Every 15 min. A cycle only executes Wialon reports for vehicles whose own
# fuel readings moved, so a quiet cycle costs nothing.
FUEL_SYNC_CRON=*/15 * * * *

# The settle pass. Each cycle re-reads a rotating slice of vehicles over a
# window that has finished maturing and makes the ledger MATCH the provider for
# it — deleting events Wialon has since retracted, and reaching vehicles whose
# telemetry is too sparse to ever trigger the movement check.
#
# Turn this off only while a manual `sync:fuel --reconcile` is running: both
# reconcile the same 6h-back window and would race. Turn it straight back on —
# without it the ledger only ever grows, which is what let one drain be counted
# as ten. See docs/fuel-ledger-fidelity.md.
FUEL_SETTLE_ENABLED=true
# Vehicles per cycle. ~460 instrumented vehicles come round in under six hours
# at 20, for about a minute of extra Wialon time per cycle. 0 disables the pass.
FUEL_SETTLE_BATCH=20
# Check the provider's drain claims against our own tank readings before they
# count as a loss or reach the feed. 40% (KASULU) / 50% (SUKARI) of decidable
# loss volume is fuel that came back with no filling — see
# docs/analytics-fidelity-plan.md. Costs 20 minutes of notification delay.
FUEL_ADJUDICATION_ENABLED=true

# ── Transactional mail (Mailtrap) ────────────────────────────────────────────
# Unset = the mailer is DORMANT: nothing is sent, nothing fails, a warn is
# logged. That is the correct default and the state the tests cover.
# The real API token belongs in .env on the box, NEVER in this file — this one
# is committed. Note `npm run dev` reads THIS file, so a token here would be a
# token in git history.
# MAIL_FROM_EMAIL must be on a domain VERIFIED in Mailtrap. raioperations.com
# is verified; demomailtrap.co is NOT enabled on this account and is refused
# with `550 5.7.1 Sending from domain demomailtrap.co is not allowed`.
# The token doubles as the SMTP password.
MAILTRAP_API_TOKEN=
MAILTRAP_SMTP_HOST=live.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USER=api
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Rai Group Fleet
# Dashboard origin used to build invite and reset links. Counts toward
# "configured": without it the mailer stays dormant rather than send a broken link.
APP_BASE_URL=
INVITE_TTL_S=604800
PASSWORD_RESET_TTL_S=3600
# Repair reports — who is told when a technician files one. Comma-separated,
# one list for every organisation. Empty = filed and on the live feed, but
# mailed to nobody; the dashboard says so rather than showing a tick.
REPAIR_NOTIFY_EMAILS=ops@example.com
# Rate limits on the public account routes.
#
# The *_RATE_LIMIT_MAX pair is per MACHINE — the key is `ip|device`, not the IP
# alone, because a company sits behind one NAT and a per-IP budget is a budget
# for the whole building. The *_IP_* pair is the ceiling over the top, which a
# caller who discards device ids to mint fresh buckets cannot escape.
#
# SETUP_* is separate from PASSWORD_RESET_* and much looser, and they must stay
# separate: asking for a reset mails an address the caller chose, while opening
# the link that mail contained sends nothing and needs a single-use token the
# caller already holds. They shared one five-request budget until an office
# discovered that a setup costs two of them.
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_IP_RATE_LIMIT_MAX=30
SETUP_RATE_LIMIT_MAX=30
SETUP_IP_RATE_LIMIT_MAX=300
REFRESH_IP_RATE_LIMIT_MAX=600
