NODE_ENV=development
PORT=3000

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_JWT_SECRET=<your-jwt-secret-min-32-chars>

DATABASE_URL="postgresql://<user>:<password>@<pooler-host>:6543/<db>?pgbouncer=true"
DIRECT_URL="postgresql://<user>:<password>@<direct-host>:5432/<db>"

CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
INGEST_RATE_LIMIT_MAX=500
