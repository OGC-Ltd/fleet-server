# Only what the Dockerfile copies matters; everything else stays out of the
# build context so secrets, caches and local junk can never reach an image.
node_modules
dist
coverage
generated
.cache
.env
.env.*
*.pem
# The one exception: Amazon's PUBLIC RDS root certificates, so the app can
# verify the database (sslmode=verify-full). Never put a key in deploy/certs.
!deploy/certs/rds-*-bundle.pem
*.log
*.patch
*.pdf
.git
.github
.claude
.hallmark
bench
docs
tests
prod
**/*.test.ts
